{
	"lsp": {
		"astro-language-server": {
			"initialization_options": {
				"contentIntellisense": true,
				// The server throws without a tsdk; the relative path resolves against the workspace root
				"typescript": { "tsdk": "node_modules/typescript/lib" }
			}
		},
		// Tailwind v4 at-rules (`@theme`, `@utility`, `@plugin`) are unknown to the CSS service
		"vscode-css-language-server": {
			"settings": { "css": { "lint": { "unknownAtRules": "ignore" } } }
		},
		// Auto-imports use the `#` alias from package.json `imports` rather than a relative path
		"vtsls": {
			"settings": { "typescript": { "preferences": { "importModuleSpecifier": "non-relative" } } }
		}
	}
}
