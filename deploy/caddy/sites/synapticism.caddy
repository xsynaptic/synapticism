www.synapticism.com {
	tls /certs/synapticism.com.pem /certs/synapticism.com.private.pem
	redir https://synapticism.com{uri} permanent
}

synapticism.com {
	tls /certs/synapticism.com.pem /certs/synapticism.com.private.pem
	root * /var/www/synapticism
	file_server
	encode gzip

	handle_errors {
		rewrite * /404.html
		file_server
	}

	@no_trailing_slash {
		path_regexp notrail ^(.+[^/])$
		not path_regexp \.[a-zA-Z0-9]+$
	}
	redir @no_trailing_slash {re.notrail.1}/ 301

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@static path *.css *.js *.jpg *.jpeg *.png *.gif *.webp *.avif *.woff2 *.woff
	header @static Cache-Control "public, max-age=31536000"

	@html path *.html /
	header @html Cache-Control "public, max-age=3600"
}

u.synapticism.com {
	tls /certs/synapticism.com.pem /certs/synapticism.com.private.pem
	handle /robots.txt {
		respond "User-agent: *
Disallow: /"
	}
	reverse_proxy umami:3000
}
