{
	"name": "synapticism",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm lqip && astro check && astro build && pnpm --filter @synapticism/scripts run og-image --root-path=$PWD",
		"lqip": "pnpm --filter @synapticism/scripts run lqip --root-path=$PWD",
		"og-image": "astro sync && pnpm --filter @synapticism/scripts run og-image --root-path=$PWD",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"check-content": "mdxlint-content packages/content --root-path=$PWD",
		"fix-content": "mdxlint-content packages/content --fix --root-path=$PWD",
		"lint-css": "stylelint \"{src,packages}/**/*.{css,astro}\"",
		"lint-css-fix": "stylelint \"{src,packages}/**/*.{css,astro}\" --fix",
		"knip": "knip",
		"fix": "stylelint \"{src,packages}/**/*.{css,astro}\" --fix --cache --cache-location node_modules/.cache/stylelint/ && prettier --write . --cache && eslint --fix --cache --cache-location node_modules/.cache/eslint/ && astro check && tsc --noEmit --extendedDiagnostics && knip",
		"check": "stylelint \"{src,packages}/**/*.{css,astro}\" && prettier --check . && eslint && astro check && tsc --noEmit --extendedDiagnostics && knip",
		"check-types": "tsc --noEmit --extendedDiagnostics",
		"deploy-site": "pnpm --filter @synapticism/scripts run deploy-site --root-path=$PWD",
		"deploy-app": "pnpm --filter @synapticism/scripts run deploy-app --root-path=$PWD"
	},
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"@synapticism/lab": "workspace:*",
		"astro": "^7.1.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/markdown-satteri": "^0.3.4",
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@keyv/sqlite": "^4.0.8",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.17",
		"@xsynaptic/eslint-config": "^6.1.0",
		"@xsynaptic/mdxlint-config": "^0.2.0",
		"@xsynaptic/satteri-auto-import": "^0.1.1",
		"@xsynaptic/satteri-reading-time": "^0.2.0",
		"@xsynaptic/stylelint-config": "^0.1.2",
		"@xsynaptic/unified-tools": "^5.1.2",
		"@xsynaptic/word-count": "^0.2.0",
		"astro-pagefind": "^2.0.1",
		"astro-seo": "^1.1.0",
		"eslint": "^10.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.7.0",
		"keyv": "^5.6.0",
		"knip": "^6.27.0",
		"ohash": "^2.0.11",
		"p-memoize": "^8.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remeda": "^2.39.0",
		"satteri": "^0.9.5",
		"satteri-expressive-code": "^0.1.18",
		"sharp": "^0.35.3",
		"stylelint": "^17.14.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"url-join": "^5.0.0",
		"wrangler": "^4.112.0",
		"yaml": "^2.8.3",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@11.15.1"
}
