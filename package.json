{
	"name": "synapticism",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm lqip && astro check && astro build && pnpm --filter @synapticism/scripts run og-image --root-path=$PWD",
		"lqip": "pnpm --filter @synapticism/scripts run lqip --root-path=$PWD",
		"og-image": "astro sync && pnpm --filter @synapticism/scripts run og-image --root-path=$PWD",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-content": "pnpm --filter synapticism-content lint",
		"lint-css": "stylelint \"src/**/*.{css,astro}\"",
		"lint-css-fix": "stylelint \"src/**/*.{css,astro}\" --fix",
		"knip": "knip",
		"fix": "stylelint \"src/**/*.{css,astro}\" --fix --cache --cache-location node_modules/.cache/stylelint/ && prettier --write . --cache && eslint --fix --cache --cache-location node_modules/.cache/eslint/ && astro check && tsc --noEmit --extendedDiagnostics && knip",
		"check": "stylelint \"src/**/*.{css,astro}\" && prettier --check . && eslint && astro check && tsc --noEmit --extendedDiagnostics && knip",
		"check-types": "tsc --noEmit --extendedDiagnostics",
		"deploy-site": "pnpm --filter @synapticism/scripts run deploy-site --root-path=$PWD",
		"deploy-app": "pnpm --filter @synapticism/scripts run deploy-app --root-path=$PWD"
	},
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"astro": "^7.0.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/markdown-satteri": "^0.3.2",
		"@astrojs/mdx": "7.0.0",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.1",
		"@types/react": "^19.2.17",
		"@xsynaptic/eslint-config": "^5.1.0",
		"@xsynaptic/satteri-auto-import": "^0.1.1",
		"@xsynaptic/stylelint-config": "^0.1.1",
		"@xsynaptic/unified-tools": "^5.1.1",
		"astro-pagefind": "^2.0.0",
		"astro-seo": "^1.1.0",
		"eslint": "^10.6.0",
		"eslint-plugin-astro": "^2.1.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.7.0",
		"knip": "^6.21.0",
		"p-memoize": "^8.0.0",
		"prettier": "^3.8.5",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remeda": "^2.39.0",
		"satteri": "^0.9.3",
		"satteri-expressive-code": "^0.1.16",
		"sharp": "^0.35.2",
		"stylelint": "^17.14.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"url-join": "^5.0.0",
		"wrangler": "^4.105.0",
		"yaml": "^2.8.3",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
