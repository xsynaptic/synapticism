{
	"name": "synapticism",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-strict": "ESLINT_STRICT=1 eslint",
		"lint-content": "pnpm --filter synapticism-content lint",
		"knip": "knip",
		"check": "prettier --write . && tsc --noEmit && astro check && eslint --fix && knip",
		"check-types": "tsc --noEmit --extendedDiagnostics",
		"deploy-site": "pnpm --filter @synapticism/scripts run deploy-site --root-path=$PWD",
		"deploy-app": "pnpm --filter @synapticism/scripts run deploy-app --root-path=$PWD"
	},
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"astro": "^6.0.8"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@astrojs/mdx": "5.0.2",
		"@astrojs/node": "10.0.3",
		"@astrojs/rss": "4.0.17",
		"@astrojs/sitemap": "^3.7.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/react": "^19.2.14",
		"@unpic/astro": "^1.0.2",
		"@unpic/core": "^1.0.3",
		"@xsynaptic/eslint-config": "^3.2.1",
		"@xsynaptic/unified-tools": "^3.0.2",
		"astro-auto-import": "^0.5.1",
		"astro-pagefind": "^1.8.5",
		"astro-seo": "^1.1.0",
		"eslint": "^9.39.4",
		"eslint-plugin-astro": "^1.6.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.4.0",
		"knip": "^6.0.1",
		"p-memoize": "^8.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"remeda": "^2.33.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"url-join": "^5.0.0",
		"yaml": "^2.8.3",
		"zod": "^4.3.6"
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
