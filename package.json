{
	"name": "synapticism",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-strict": "ESLINT_STRICT=1 eslint",
		"lint-content": "pnpm --filter synapticism-content lint",
		"lint-css": "stylelint \"src/**/*.{css,astro}\"",
		"lint-css-fix": "stylelint \"src/**/*.{css,astro}\" --fix",
		"knip": "knip",
		"format": "stylelint \"src/**/*.{css,astro}\" --fix && prettier --write . && eslint --fix && tsc --noEmit --extendedDiagnostics && astro check && knip",
		"check-types": "tsc --noEmit --extendedDiagnostics",
		"deploy-site": "pnpm --filter @synapticism/scripts run deploy-site --root-path=$PWD",
		"deploy-app": "pnpm --filter @synapticism/scripts run deploy-app --root-path=$PWD"
	},
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"astro": "7.0.0-beta.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/markdown-satteri": "0.3.1-alpha.0",
		"@astrojs/mdx": "7.0.0-alpha.1",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.2.17",
		"@unpic/astro": "^1.0.2",
		"@unpic/core": "^1.0.3",
		"@xsynaptic/eslint-config": "^3.8.0",
		"@xsynaptic/stylelint-config": "^0.1.1",
		"@xsynaptic/unified-tools": "^5.1.0",
		"astro-pagefind": "^2.0.0",
		"astro-seo": "^1.1.0",
		"eslint": "^9.39.4",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.6.0",
		"knip": "^6.16.1",
		"p-memoize": "^8.0.0",
		"prettier": "^3.8.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remeda": "^2.39.0",
		"satteri": "0.8.1",
		"satteri-expressive-code": "0.1.11",
		"stylelint": "^17.13.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"url-join": "^5.0.0",
		"yaml": "^2.8.3",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
