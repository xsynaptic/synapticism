{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"strictNullChecks": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	},
	"include": [
		"../../.astro/types.d.ts",
		"global.d.ts",
		"astro-modules.d.ts",
		"collections/**/*",
		"data/**/*"
	],
	"mdx": {
		"checkMdx": true
	}
}
