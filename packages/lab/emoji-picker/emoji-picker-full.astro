---
import type { GridCatalog } from '#emoji-picker/core/catalog-types.ts';
import type { EmojiPickerProps } from '#emoji-picker/emoji-picker-types.ts';

import { supportProbes } from '#emoji-picker/core/support-probes.ts';
import catalog from '#emoji-picker/data/grid-en.json';
import {
	emojiSizeLabels,
	emojiSizes,
	recentsRows,
	storageKey,
} from '#emoji-picker/emoji-picker-constants.ts';
import stylesheetUrl from '#emoji-picker/emoji-picker.css?url';

type Props = Omit<EmojiPickerProps, 'href'>;

const { class: className } = Astro.props;

const { groups } = catalog satisfies GridCatalog;

const groupKeys: Record<string, string> = {
	activities: '⚽',
	'animals-nature': '🐻',
	flags: '🏁',
	'food-drink': '🍔',
	objects: '💡',
	'people-body': '👋',
	'smileys-emotion': '😀',
	symbols: '🔣',
	'travel-places': '✈️',
};

const toneLabels = [
	'Default skin tone',
	'Light skin tone',
	'Medium-light skin tone',
	'Medium skin tone',
	'Medium-dark skin tone',
	'Dark skin tone',
];

const firstHexcode = groups[0]?.emoji[0]?.hexcode;

const toneSample = groups
	.flatMap((group) => group.emoji)
	.find((item) => item.hexcode === '270B' && item.skins !== undefined);

const probes = JSON.stringify(supportProbes(catalog));

// The inline script mirrors the element's paint; keep them in step or the upgrade repaints
---

<link href={stylesheetUrl} rel="stylesheet" />
<emoji-picker
	class={className}
	data-lab
	data-pagefind-ignore="all"
	data-probes={probes}
	style="

--lab-height: min(32rem, 80dvh)"
>
	<div class="ep-top">
		<div class="ep-toolbar">
			<div class="ep-search">
				<input
					aria-label="Search emoji"
					autocomplete="off"
					enterkeyhint="search"
					placeholder="Search emoji"
					spellcheck="false"
					type="search"
				/>
				<kbd aria-hidden="true">/</kbd>
				<button
					aria-label="Clear search"
					class="ep-search-clear"
					title="Clear search"
					type="button"
				>
					<svg aria-hidden="true" height="16" viewBox="0 0 16 16" width="16">
						<path
							d="M4 4l8 8M12 4l-8 8"
							fill="none"
							stroke="currentColor"
							stroke-linecap="round"
							stroke-width="1.75"
						/>
					</svg>
				</button>
			</div>
			<div aria-label="Emoji size" class="ep-size" role="group">
				{emojiSizes.map((size) => (
					<button
						aria-label={emojiSizeLabels[size]}
						aria-pressed={size === 'small' ? 'true' : 'false'}
						data-size={size}
						title={emojiSizeLabels[size]}
						type="button"
					>
						🙂
					</button>
				))}
			</div>
			{toneSample ? (
				<button
					aria-expanded="false"
					aria-haspopup="true"
					aria-label="Skin tone"
					class="ep-tone-button"
					data-hexcode={toneSample.hexcode}
					data-skins={toneSample.skins && [toneSample.emoji, ...toneSample.skins].join(' ')}
					title="Skin tone"
					type="button"
				>
					{toneSample.emoji}
				</button>
			) : undefined}
		</div>
		<nav
			aria-label="Emoji categories"
			class="ep-categories"
			style={`--ep-tabs: ${String(groups.length + 1)}`}
		>
			<a aria-label="Recently used" href="#emoji-picker-recents" title="Recently used">
				🕘
			</a>
			{groups.map((group) => (
				<a aria-label={group.label} href={`#emoji-picker-${group.key}`} title={group.label}>
					{groupKeys[group.key]}
				</a>
			))}
		</nav>
	</div>
	<div class="ep-scroll">
		<section
			aria-labelledby="emoji-picker-recents-title"
			class="ep-recents"
			hidden
			id="emoji-picker-recents"
		>
			<div class="ep-recents-head">
				<h2 id="emoji-picker-recents-title">Recently used</h2>
				<button class="ep-recents-clear" type="button">
					Clear
				</button>
			</div>
			<div class="ep-cells" />
			<p class="ep-recents-empty">Start copying emoji to populate this section.</p>
		</section>
		<section aria-labelledby="emoji-picker-results-title" class="ep-results" hidden>
			<h2 class="sr-only" id="emoji-picker-results-title">
				Search results
			</h2>
			<div class="ep-cells" />
			<p class="ep-results-empty" hidden>
				No emoji match. Try a broader word, or a shortcode such as <code>:smile:</code>.
			</p>
			<p class="ep-results-failed" hidden>
				Search could not load. Reload the page to try again.
			</p>
		</section>
		{groups.map((group) => (
			<section
				aria-labelledby={`emoji-picker-${group.key}-title`}
				class="ep-group"
				id={`emoji-picker-${group.key}`}
				style={`--ep-count: ${String(group.emoji.length)}`}
			>
				<h2 id={`emoji-picker-${group.key}-title`}>{group.label}</h2>
				<div class="ep-cells">
					{group.emoji.map((item) => (
						<button
							aria-label={item.label}
							data-hexcode={item.hexcode}
							data-skin-version={item.skinVersion}
							data-skins={item.skins && [item.emoji, ...item.skins].join(' ')}
							data-version={item.version}
							tabindex={item.hexcode === firstHexcode ? 0 : -1}
							type="button"
						>
							{item.emoji}
						</button>
					))}
				</div>
			</section>
		))}
	</div>
	<div class="ep-detail">
		<span aria-hidden="true" class="ep-detail-glyph" />
		<div class="ep-detail-text">
			<p class="ep-detail-name">Pick an emoji to copy it</p>
			<p class="ep-detail-hint" hidden>
				Hold for skin tones
			</p>
			<p class="ep-detail-note" hidden />
		</div>
	</div>
	<p aria-hidden="true" class="ep-bubble" popover="manual" />
	<p class="ep-announcer sr-only" role="status" />
	<div aria-label="Skin tones" class="ep-tones" popover="manual" role="group">
		{toneLabels.map((label, tone) => (
			<button aria-label={label} data-tone={tone} type="button" />
		))}
	</div>
</emoji-picker>
<script define:vars={{ emojiSizes, recentsRows, storageKey }} is:inline>
	const picker = document.currentScript?.previousElementSibling;
	let state;

	try {
		state = JSON.parse(localStorage.getItem(storageKey) ?? '{}').state ?? {};
	} catch {
		state = {};
	}

	function paintTone(button, tone) {
		const glyph = button.dataset.skins?.split(' ')[tone];

		if (glyph) button.textContent = glyph;
	}

	function recentsShown(container, recents) {
		const columns = Number(getComputedStyle(container).getPropertyValue('--ep-columns')) || 1;

		return recents.slice(0, columns * recentsRows);
	}

	function paintRecents(picker, recents) {
		const section = picker.querySelector(':scope .ep-recents');
		const container = section?.querySelector(':scope > .ep-cells');

		if (!section || !container) return;

		const shown = recentsShown(container, recents);

		for (const hexcode of shown) {
			const clone = picker
				.querySelector(`:scope .ep-group [data-hexcode="${CSS.escape(hexcode)}"]`)
				?.cloneNode(true);

			if (!clone) continue;

			clone.tabIndex = -1;
			container.append(clone);
		}

		section.hidden = false;
		picker.querySelector(':scope .ep-categories a')?.setAttribute('aria-current', 'true');
	}

	function paintSize(picker, size) {
		if (!emojiSizes.includes(size)) return;

		picker.dataset.size = size;

		for (const button of picker.querySelectorAll(':scope .ep-size button')) {
			button.setAttribute('aria-pressed', String(button.dataset.size === size));
		}
	}

	function paintCell(cell, tone, supportedVersion) {
		const version = Number(
			(tone > 0 ? cell.dataset.skinVersion : undefined) ?? cell.dataset.version,
		);

		paintTone(cell, tone);
		cell.classList.toggle('ep-unsupported', version > supportedVersion);
	}

	function paintCells(picker, { supportedVersion = Infinity, tone = 0, tones = {} }) {
		const toneButton = picker.querySelector(':scope .ep-tone-button');

		if (toneButton) paintTone(toneButton, tone);

		for (const cell of picker.querySelectorAll(':scope .ep-group .ep-cells > button')) {
			const cellTone = cell.dataset.skins === undefined ? 0 : (tones[cell.dataset.hexcode] ?? tone);

			paintCell(cell, cellTone, supportedVersion);
		}
	}

	function paintStored(picker) {
		paintSize(picker, state.size);
		paintCells(picker, state);
		paintRecents(picker, state.recents ?? []);
	}

	if (picker) paintStored(picker);
</script>

<script>
	import '#emoji-picker/client/emoji-picker.ts';
</script>
