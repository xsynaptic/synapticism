---
import type { GridCatalog } from '#emoji-picker/core/catalog-types.ts';
import type { EmojiPickerProps as Props } from '#emoji-picker/emoji-picker-types.ts';

import { supportProbes } from '#emoji-picker/core/support-probes.ts';
import catalog from '#emoji-picker/data/grid-en.json';
import '#emoji-picker/emoji-picker.css';
import { emojiSizeLabels, emojiSizes } from '#emoji-picker/emoji-picker-constants.ts';

const { class: className, href } = Astro.props;

const { isFeed } = Astro.locals;

const { groups } = catalog satisfies GridCatalog;

const groupKeys: Record<string, string> = {
	activities: '⚽',
	'animals-nature': '🐻',
	flags: '🏁',
	'food-drink': '🍔',
	objects: '💡',
	'people-body': '👋',
	'smileys-emotion': '😀',
	symbols: '🔣',
	'travel-places': '✈️',
};

const toneLabels = [
	'Default skin tone',
	'Light skin tone',
	'Medium-light skin tone',
	'Medium skin tone',
	'Medium-dark skin tone',
	'Dark skin tone',
];

const firstHexcode = groups[0]?.emoji[0]?.hexcode;

const probes = JSON.stringify(supportProbes(catalog));
---

{isFeed ? (
	href === undefined ? undefined : (
		<p>
			<a href={href}>Open the emoji picker.</a>
		</p>
	)
) : (
	<emoji-picker class:list={['ep', className]} data-pagefind-ignore="all" data-probes={probes}>
		<div class="ep-top">
			<div class="ep-toolbar">
				<label class="ep-search">
					<span class="sr-only">Search emoji</span>
					<input
						autocomplete="off"
						enterkeyhint="search"
						placeholder="Search emoji"
						spellcheck="false"
						type="search"
					/>
					<kbd aria-hidden="true">/</kbd>
				</label>
				<div aria-label="Emoji size" class="ep-size" role="group">
					{emojiSizes.map((size) => (
						<button
							aria-label={emojiSizeLabels[size]}
							aria-pressed={size === 'small' ? 'true' : 'false'}
							data-size={size}
							title={emojiSizeLabels[size]}
							type="button"
						>
							🙂
						</button>
					))}
				</div>
			</div>
			<nav aria-label="Emoji categories" class="ep-categories">
				<a aria-label="Recently used" href="#emoji-picker-recents" title="Recently used">
					🕘
				</a>
				{groups.map((group) => (
					<a aria-label={group.label} href={`#emoji-picker-${group.key}`} title={group.label}>
						{groupKeys[group.key]}
					</a>
				))}
			</nav>
		</div>
		<div class="ep-scroll">
			<section
				aria-labelledby="emoji-picker-recents-title"
				class="ep-recents"
				hidden={true}
				id="emoji-picker-recents"
			>
				<h2 id="emoji-picker-recents-title">Recently used</h2>
				<div class="ep-cells" />
				<p class="ep-recents-empty">Emoji you copy land here.</p>
			</section>
			<section aria-labelledby="emoji-picker-results-title" class="ep-results" hidden={true}>
				<h2 class="sr-only" id="emoji-picker-results-title">
					Search results
				</h2>
				<div class="ep-cells" />
				<p class="ep-results-empty" hidden={true}>
					No emoji match. Try a broader word, or a shortcode such as <code>:smile:</code>.
				</p>
			</section>
			{groups.map((group) => (
				<section
					aria-labelledby={`emoji-picker-${group.key}-title`}
					class="ep-group"
					id={`emoji-picker-${group.key}`}
					style={`--ep-count: ${String(group.emoji.length)}`}
				>
					<h2 id={`emoji-picker-${group.key}-title`}>{group.label}</h2>
					<div class="ep-cells">
						{group.emoji.map((item) => (
							<button
								aria-label={item.label}
								data-hexcode={item.hexcode}
								data-skin-version={item.skinVersion}
								data-skins={item.skins?.join(' ')}
								data-version={item.version}
								tabindex={item.hexcode === firstHexcode ? 0 : -1}
								type="button"
							>
								{item.emoji}
							</button>
						))}
					</div>
				</section>
			))}
		</div>
		<div class="ep-detail">
			<span aria-hidden="true" class="ep-detail-glyph" />
			<div class="ep-detail-text">
				<p class="ep-detail-name">Pick an emoji to copy it</p>
				<div class="ep-detail-meta">
					<span class="ep-detail-code" />
					<span class="ep-detail-hint" hidden={true}>
						Hold for skin tones
					</span>
					<span class="ep-detail-note" hidden={true}>
						May not display on this device
					</span>
					<ul aria-label="Shortcodes" class="ep-detail-shortcodes" />
				</div>
				<p class="ep-detail-keywords" />
			</div>
		</div>
		<p class="ep-toast" role="status" />
		<div aria-label="Skin tones" class="ep-tones" popover="manual" role="group">
			{toneLabels.map((label, tone) => (
				<button aria-label={label} data-tone={tone} type="button" />
			))}
		</div>
	</emoji-picker>
)}

<script>
	import '#emoji-picker/client/emoji-picker.ts';
</script>
