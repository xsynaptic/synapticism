---
import type { StationTileLabProps } from '#station-tile/station-tile-types.ts';

import styles from '#station-tile/client/station-tile-lab.css?inline';
import {
	defaultTileTheme,
	glossBlends,
	isTileTheme,
	tileDefaults,
	tileThemes,
} from '#station-tile/core/appearance.ts';
import {
	exportFormats,
	formatRangeValue,
	isRangeActive,
	labColors,
	labRanges,
} from '#station-tile/station-tile-lab-controls.ts';

// Declarative shadow DOM lays the lab out at full height before its script loads
// A shadow root cannot read the page cascade, so its styles ship inline with it
type Props = Omit<StationTileLabProps, 'href'>;

const { class: className, seed = tileDefaults.seed, theme } = Astro.props;

// MDX props arrive unchecked; the select must show the theme the generator actually falls back to
const selectedTheme = theme !== undefined && isTileTheme(theme) ? theme : defaultTileTheme;
---

<station-tile-lab class:list={[className]}>
	<template shadowrootmode="open">
		<Fragment set:html={`<style>${styles}</style>`} />
		<div class="lab">
			<div class="preview">
				<station-tile />
			</div>
			<form class="controls">
				<label class="field">
					<span class="field-head">
						<span class="field-name">Theme</span>
					</span>
					<select name="theme">
						{Object.keys(tileThemes).map((name) => (
							<option selected={name === selectedTheme}>{name}</option>
						))}
					</select>
				</label>
				<div class="field">
					<label class="field-head" for="seed">
						<span class="field-name">Seed</span>
					</label>
					<div class="control-row">
						<input id="seed" name="seed" type="text" value={String(seed)} />
						<button aria-label="Randomize seed" class="randomize" type="button">
							<svg
								aria-hidden="true"
								fill="none"
								height="14"
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								viewBox="0 0 24 24"
								width="14"
							>
								<path d="m18 14l4 4l-4 4m0-20l4 4l-4 4" />
								<path d="M2 18h1.973a4 4 0 0 0 3.3-1.7l5.454-8.6a4 4 0 0 1 3.3-1.7H22M2 6h1.972a4 4 0 0 1 3.6 2.2M22 18h-6.041a4 4 0 0 1-3.3-1.8l-.359-.45" />
							</svg>
						</button>
					</div>
				</div>
				{labRanges.map((range) => (
					<label class="field">
						<span class="field-head">
							<span class="field-name">{range.label}</span>
							<span class="field-value">{formatRangeValue(range.value)}</span>
						</span>
						<input
							aria-label={range.label}
							disabled={!isRangeActive(range, false)}
							max={range.max}
							min={range.min}
							name={range.key}
							step={range.step}
							type="range"
							value={range.value}
						/>
					</label>
				))}
				<div class="field">
					<span class="field-head">
						<span class="field-name">Grout / gloss tint</span>
					</span>
					<div class="control-row">
						{labColors.map((color) => (
							<input aria-label={color.label} name={color.key} type="color" value={color.value} />
						))}
					</div>
				</div>
				<label class="field">
					<span class="field-head">
						<span class="field-name">Gloss blend</span>
					</span>
					<select name="glossBlend">
						{glossBlends.map((name) => (
							<option selected={name === tileDefaults.glossBlend}>{name}</option>
						))}
					</select>
				</label>
				<label class="field toggle">
					<input name="seamless" type="checkbox" />
					<span class="field-name">Seamless</span>
				</label>
				<div class="field">
					<span class="field-head">
						<span class="field-name">Download</span>
					</span>
					<div class="control-row">
						{exportFormats.map((format) => (
							<button data-format={format} type="button">
								{format.toUpperCase()}
							</button>
						))}
					</div>
				</div>
				<button class="reset" type="button">
					Reset
				</button>
			</form>
		</div>
	</template>
</station-tile-lab>

<script>
	import '#station-tile/client/station-tile-lab.ts';
</script>
