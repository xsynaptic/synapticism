---
import type { StationTileLabProps as Props } from './station-tile-types.ts';

const { class: className, href, seed, theme } = Astro.props;

const { isRss } = Astro.locals;

const attributes: Record<string, string> = {};

if (theme !== undefined) attributes.theme = theme;
if (seed !== undefined) attributes.seed = String(seed);

const reservedStyle = { display: 'block', minHeight: '838px' };
---

{
	isRss ? (
		href === undefined ? undefined : (
			<p>
				<a href={href}>Open the interactive station tile lab.</a>
			</p>
		)
	) : (
		<station-tile-lab class:list={[className]} style={reservedStyle} {...attributes} />
	)
}

<script>
	import './client/station-tile-lab.ts';
</script>
