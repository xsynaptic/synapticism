---
import type { TileInput } from './core/options.ts';

import { generateTileSvg, tileBackgroundStyle } from './core/render.ts';

interface Props extends TileInput {
	class?: string | undefined;
}

const { class: className, ...input } = Astro.props;

const { isRss } = Astro.locals;

const generated = generateTileSvg(input);

const style = {
	aspectRatio: 'var(--station-tile-aspect, 16 / 7)',
	...tileBackgroundStyle(generated),
};
---

{
	isRss ? undefined : (
		<div aria-hidden="true" class:list={['station-tile', className]} style={style} />
	)
}
