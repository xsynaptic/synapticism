---
import type { StationTileProps as Props } from '#station-tile/station-tile-types.ts';

import { TILE_DEFAULTS } from '#station-tile/core/appearance.ts';
import { generateTileSvg, tileBackgroundStyle } from '#station-tile/core/render.ts';

const { aspectRatio = TILE_DEFAULTS.aspectRatio, class: className, ...input } = Astro.props;

const { isRss } = Astro.locals;

const generated = generateTileSvg({ ...input, aspectRatio });

const style = {
	aspectRatio: String(aspectRatio),
	...tileBackgroundStyle(generated),
};
---

{isRss ? undefined : (
	<div aria-hidden="true" class:list={['station-tile', className]} style={style} />
)}
