{
	"name": "@synapticism/scripts",
	"version": "1.0.0",
	"description": "Scripts for Synapticism",
	"type": "module",
	"private": true,
	"exports": {
		"./og-image": "./src/og-image/inventory-exports.ts"
	},
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"deploy-site": "node --env-file-if-exists=../../.env ./src/deploy/deploy.ts",
		"deploy-app": "node --env-file-if-exists=../../.env ./src/deploy/deploy-app.cli.ts",
		"og-image": "node --import tsx ./src/og-image/index.ts",
		"validate-content": "node ./src/validate-content/index.ts"
	},
	"devDependencies": {
		"@fontsource/aleo": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@synapticism/shared": "workspace:*",
		"@types/react": "^19.3.0",
		"@xsynaptic/astro-image-pipeline": "^0.11.1",
		"@xsynaptic/astro-scripts": "^0.14.0",
		"astro": "^7.4.4",
		"react": "^19.3.1",
		"satteri": "^0.10.5",
		"sharp": "^0.35.5",
		"takumi-js": "^2.18.2",
		"tsx": "^4.23.15"
	}
}
