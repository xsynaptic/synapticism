{
	"name": "@synapticism/scripts",
	"version": "1.0.0",
	"description": "Scripts for Synapticism",
	"type": "module",
	"private": true,
	"exports": {
		"./og-image": "./src/og-image/inventory-exports.ts"
	},
	"imports": {
		"#shared/*": "./src/shared/*"
	},
	"scripts": {
		"deploy-site": "NODE_ENV=production tsx --env-file-if-exists=../../.env ./src/deploy/deploy.ts",
		"deploy-app": "tsx --env-file-if-exists=../../.env ./src/deploy/deploy-app.cli.ts",
		"lqip": "tsx ./src/lqip/index.ts",
		"og-image": "tsx ./src/og-image/index.ts",
		"sitemap-lastmod": "tsx ./src/sitemap-lastmod/index.cli.ts",
		"validate-content": "tsx ./src/validate-content/index.ts"
	},
	"devDependencies": {
		"@fontsource/aleo": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@types/react": "^19.2.18",
		"astro": "^7.3.1",
		"chalk": "^6.0.0",
		"react": "^19.2.8",
		"sharp": "^0.35.4",
		"takumi-js": "^2.13.5",
		"tsx": "^4.23.13",
		"vite": "^8.2.2",
		"zx": "^8.8.5"
	}
}
