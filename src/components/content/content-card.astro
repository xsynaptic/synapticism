---
import type { ComponentProps } from 'astro/types';

import ContentSubtitle from '#components/content/content-subtitle.astro';
import EntryTitle from '#components/content/entry-title.astro';
import ChipRow from '#components/parts/chip-row.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	class?: string | undefined;
	description: string | undefined;
	tagItems: ComponentProps<typeof ChipRow>['items'];
	title: string;
	url: string;
}

const { class: className, description, tagItems, title, url } = Astro.props;

const subtitle = await renderSlot(Astro.slots, 'card-subtitle');
---

<article class:list={['flex flex-col gap-4', MicroformatClassNames.Entry, className]}>
	<slot name="card-media" />
	<header>
		<EntryTitle as="h2" href={url}>
			{title}
		</EntryTitle>
		{subtitle ? <ContentSubtitle html={subtitle} /> : undefined}
	</header>
	{description ? (
		<p
			class:list={['leading-relaxed text-primary-700', MicroformatClassNames.Summary]}
			set:html={description}
		/>
	) : undefined}
	<ChipRow chipProps={{ class: MicroformatClassNames.Category }} items={tagItems} />
	<slot name="card-links" />
</article>
