---
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	class?: string | undefined;
	href: string;
}

const { class: className, href } = Astro.props;
---

<div class:list={['flex items-baseline gap-1 text-sm font-medium italic', className]}>
	<Anchor class="anchor-ink-title" href={href} underline="hover">
		{t('content.continueReading')}
	</Anchor>
	<span aria-hidden="true" class="shrink-0 text-primary-600">
		&rarr;
	</span>
</div>
