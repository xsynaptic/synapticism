---
import type { CollectionEntry } from 'astro:content';

import type { Template } from '#lib/schemas/content.ts';

import ContentHeader from '#components/content/content-header.astro';
import ContentHero from '#components/content/content-hero.astro';
import EntrySubtitle from '#components/content/entry-subtitle.astro';
import MainSite from '#components/main/main-site.astro';
import AuthorCard from '#components/parts/author-card.astro';
import ProseBody from '#components/parts/prose-body.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { siteAuthorName } from '#constants.ts';
import { getDescriptionRenderedText } from '#lib/utils/description-data.ts';
import { getImageFeaturedHeroGroup } from '#lib/utils/image-featured.ts';
import { getEntryOpenGraphCard, getSeoArticleProps } from '#lib/utils/seo.ts';
import { getUrlPathIndexing } from '#lib/utils/sitemap.ts';
import { buildEntrySchemas } from '#lib/utils/structured-data.ts';

interface Props {
	entry: CollectionEntry<'pages' | 'posts' | 'projects'>;
	hasReadingBar: boolean;
	isArticle: boolean;
	minutesRead?: number | undefined;
	template?: Template;
}

const { entry, hasReadingBar, isArticle, minutesRead, template = 'sidebar' } = Astro.props;

const url = Astro.url.toString();

const description = getDescriptionRenderedText(entry);

const heroImage = getImageFeaturedHeroGroup({ imageFeatured: entry.data.imageFeatured })?.[0];

const articleMeta = isArticle
	? getSeoArticleProps({ dateCreated: entry.data.dateCreated, dateUpdated: entry.data.dateUpdated })
	: undefined;

const schemas = buildEntrySchemas(entry, {
	authorName: siteAuthorName,
	description,
	isArticle,
	url,
});

const { index } = getUrlPathIndexing(Astro.url.pathname);
---

<MainSite
	hasReadingBar={hasReadingBar}
	meta={{
		description,
		openGraphCard: getEntryOpenGraphCard(entry),
		title: entry.data.title,
		...articleMeta,
	}}
	schemas={schemas}
	template={template}
>
	<article
		class:list={['grow pb-8', MicroformatClassNames.Entry]}
		{...(index ? { 'data-pagefind-body': '' } : {})}
	>
		{heroImage ? (
			<ContentHero
				{...heroImage}
				fallbackAlt={entry.data.title}
				isPriority={true}
				template={template}
			/>
		) : undefined}
		<ContentHeader isLeading={!heroImage} title={entry.data.title} titleUrl={url}>
			<EntrySubtitle entry={entry} minutesRead={minutesRead} slot="header-subtitle" />
		</ContentHeader>
		<ProseBody
			class:list={['e-content', 'pb-4']}
			data-reading-frame={hasReadingBar || undefined}
			frame={template === 'full' ? 'bleed' : 'column'}
		>
			<slot />
		</ProseBody>
		<slot name="after-body" />
		<AuthorCard />
	</article>
	<slot name="after-article" />
</MainSite>
