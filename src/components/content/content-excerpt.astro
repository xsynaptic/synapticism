---
import Link from '#components/parts/link.astro';
import ProseBody from '#components/parts/prose-body.astro';
import ProseDescription from '#components/parts/prose-description.astro';
import { CONTENT_EXCERPT_IDENTIFIER } from '#constants.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	class?: string | undefined;
	entryUrl: string;
}

const { class: className, entryUrl } = Astro.props;

const subtitle = await renderSlot(Astro.slots, 'excerpt-subtitle');
const description = await renderSlot(Astro.slots, 'excerpt-description');
const content = await renderSlot(Astro.slots, 'default');

const excerptSplit = content?.split(`<!-- ${CONTENT_EXCERPT_IDENTIFIER} -->`) ?? [];
const excerptContent = excerptSplit[0];
const hasExcerpt = excerptSplit.length > 1;
---

<article class={className}>
	<header class:list={['content-column', description ? undefined : 'mb-2']}>
		<h2 class="mb-1 text-2xl font-bold lg:text-3xl">
			<a class="text-primary-700 transition-colors ease-in hover:text-accent-500" href={entryUrl}>
				<slot name="excerpt-title" />
			</a>
		</h2>
		{
			subtitle ? (
				<h3 class="mb-1 text-xs font-medium text-primary-400 md:text-sm" set:html={subtitle} />
			) : undefined
		}
		{
			description ? (
				<ProseDescription>
					<Fragment set:html={description} />
				</ProseDescription>
			) : undefined
		}
	</header>
	<ProseBody class:list={['content', 'pb-small']}><Fragment set:html={excerptContent} /></ProseBody>
	{
		hasExcerpt ? (
			<div class="content-column text-right font-serif font-medium italic">
				<Link href={entryUrl}>{t('content.continueReading')}</Link>&nbsp;&raquo;
			</div>
		) : undefined
	}
</article>
