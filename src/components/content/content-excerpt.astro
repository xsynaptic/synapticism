---
import Anchor from '#components/parts/anchor.astro';
import ProseBody from '#components/parts/prose-body.astro';
import ProseDescription from '#components/parts/prose-description.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { contentExcerptIdentifier } from '#constants.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	class?: string | undefined;
	entryUrl: string;
}

const { class: className, entryUrl } = Astro.props;

const subtitle = await renderSlot(Astro.slots, 'excerpt-subtitle');
const description = await renderSlot(Astro.slots, 'excerpt-description');
const content = await renderSlot(Astro.slots, 'default');

const excerptSplit = content?.split(`<!-- ${contentExcerptIdentifier} -->`) ?? [];
const excerptContent = excerptSplit[0];
const hasExcerpt = excerptSplit.length > 1;
---

<article class:list={[className, MicroformatClassNames.Entry]}>
	<header class:list={['content-column', description ? undefined : 'mb-2']}>
		<h2 class="mb-1 text-lg font-semibold md:text-xl">
			<Anchor class:list={[MicroformatClassNames.Url, MicroformatClassNames.Name]} href={entryUrl}
				><slot name="excerpt-title" /></Anchor
			>
		</h2>
		{
			subtitle ? (
				<div
					class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-primary-600"
					set:html={subtitle}
				/>
			) : undefined
		}
		{
			description ? (
				<ProseDescription class={MicroformatClassNames.Summary}>
					<Fragment set:html={description} />
				</ProseDescription>
			) : undefined
		}
	</header>
	<ProseBody class:list={['content', 'e-content', 'pb-4']}>
		<Fragment set:html={excerptContent} />
	</ProseBody>
	{
		hasExcerpt ? (
			<div class="content-column text-right font-serif font-medium italic">
				<Anchor href={entryUrl}>{t('content.continueReading')}</Anchor>&nbsp;&raquo;
			</div>
		) : undefined
	}
</article>
