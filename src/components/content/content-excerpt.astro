---
import ContentContinueReading from '#components/content/content-continue-reading.astro';
import ContentSubtitle from '#components/content/content-subtitle.astro';
import EntryTitle from '#components/content/entry-title.astro';
import ProseBody from '#components/parts/prose-body.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { contentExcerptIdentifier } from '#constants.ts';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	class?: string | undefined;
	entryUrl: string;
	isLeading?: boolean;
}

const { class: className, entryUrl, isLeading = false } = Astro.props;

const subtitle = await renderSlot(Astro.slots, 'excerpt-subtitle');
const hasHero = Astro.slots.has('excerpt-hero');
const content = await renderSlot(Astro.slots, 'default');

const excerptSplit = content?.split(`<!-- ${contentExcerptIdentifier} -->`) ?? [];
const excerptContent = excerptSplit[0];
const hasExcerpt = excerptSplit.length > 1;
---

<article class:list={[className, MicroformatClassNames.Entry]}>
	<header class="content-column mb-2 pb-2">
		<div class:list={[{ 'site-shell-title pt-4 md:pt-8': isLeading }]}>
			<EntryTitle as="h2" href={entryUrl}>
				<slot name="excerpt-title" />
			</EntryTitle>
		</div>
		{subtitle ? <ContentSubtitle html={subtitle} /> : undefined}
	</header>
	<slot name="excerpt-hero" />
	<ProseBody class:list={['e-content', { 'pb-4': hasExcerpt, 'pt-6': hasHero }]}>
		<Fragment set:html={excerptContent} />
	</ProseBody>
	{hasExcerpt ? (
		<ContentContinueReading class="content-column justify-end" href={entryUrl} />
	) : undefined}
</article>
