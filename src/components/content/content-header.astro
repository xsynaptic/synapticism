---
import Container from '#components/parts/container.astro';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	class?: string | undefined;
	title: string;
}

const { class: className, title } = Astro.props;

const subtitle = await renderSlot(Astro.slots, 'header-subtitle');
---

<Container as="div" class:list={['mb-2 pt-small', className]}>
	<h1
		class="-ml-0.5 pb-2 font-sans text-2xl leading-[1.125] font-semibold text-primary-900 md:text-3xl lg:text-4xl"
		data-pagefind-weight="3"
	>
		{title}
	</h1>
	{
		subtitle ? (
			<div
				class="items-start gap-1 pb-2 font-mono text-sm text-primary-600 sm:flex sm:flex-wrap"
				data-pagefind-ignore
				set:html={subtitle}
			/>
		) : undefined
	}
</Container>
