---
import { Image } from 'astro:assets';

import type { ImageFeaturedObject } from '#lib/schemas/image-featured.ts';

import { getMediaImage, getMediaLqip } from '#lib/utils/media.ts';
import { sanitizeAltAttribute } from '#lib/utils/text.ts';

interface Props extends ImageFeaturedObject {
	fallbackAlt?: string | undefined;
}

const { fallbackAlt, id, title } = Astro.props;

const alt = sanitizeAltAttribute(title ?? fallbackAlt ?? '');

const image = getMediaImage(id);
const lqip = getMediaLqip(id);
---

<figure class="content-column mb-8">
	<div
		class="overflow-hidden rounded-sm bg-cover bg-center"
		style={lqip ? `background-image:url(${lqip})` : undefined}
	>
		<Image
			alt={alt}
			class="block w-full"
			layout="constrained"
			priority
			sizes="(min-width: 58rem) 58rem, 100vw"
			src={image}
			width={1600}
		/>
	</div>
</figure>
