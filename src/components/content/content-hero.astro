---
import { getPlaceholder } from '@xsynaptic/astro-image-pipeline/node';
import { Image } from 'astro:assets';

import type { Template } from '#lib/schemas/content.ts';
import type { ImageFeaturedObject } from '#lib/schemas/image-featured.ts';

import { getMediaImage } from '#lib/utils/media.ts';
import { sanitizeAltAttribute } from '#lib/utils/text.ts';

interface Props extends ImageFeaturedObject {
	fallbackAlt?: string | undefined;
	isPriority: boolean;
	template: Template;
}

const { fallbackAlt = '', id, isPriority, template, title = fallbackAlt } = Astro.props;

const alt = sanitizeAltAttribute(title);

const image = getMediaImage(id);
const placeholder = await getPlaceholder({ height: image.height, id: id, width: image.width });

const sizes = template === 'sidebar' ? '(min-width: 64rem) 54rem, 100vw' : '100vw';
---

<figure
	class="aspect-3/2 max-h-[70svh] w-full overflow-hidden bg-placeholder md:aspect-2/1"
	style={placeholder ? `background-image:url(${placeholder})` : undefined}
>
	<Image
		alt={alt}
		class="block size-full object-cover"
		layout="constrained"
		priority={isPriority}
		sizes={sizes}
		src={image}
		width={2400}
	/>
</figure>
