---
import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ChipRow from '#components/parts/chip-row.astro';
import LabeledSection from '#components/parts/labeled-section.astro';
import LinkRow from '#components/parts/link-row.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { createProjectsByIdsFunction } from '#lib/collections/projects/projects-utils.ts';
import { getTagChipItems } from '#lib/collections/tags/tags-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props {
	projects?: Array<{ id: string }> | undefined;
	tags: Array<{ id: string }> | undefined;
}

const { projects, tags } = Astro.props;

function getRowItems(entries: Array<ComputedEntry<'projects'>>) {
	return entries.map((item) => ({
		title: item.data.title,
		url: getContentPath(item.collection, item.id),
	}));
}

const getProjectsByIds = await createProjectsByIdsFunction();

const projectItems = projects
	? getRowItems(
			getProjectsByIds(projects.map(({ id }) => id)).toSorted((projectA, projectB) =>
				projectA.data.title.localeCompare(projectB.data.title),
			),
		)
	: [];

const tagItems = await getTagChipItems(tags);
---

{projectItems.length > 0 ? (
	<LabeledSection data-nosnippet={true} data-pagefind-ignore={true} title={t('section.projects')}>
		<LinkRow items={projectItems} />
	</LabeledSection>
) : undefined}
<ChipRow
	chipProps={{ class: MicroformatClassNames.Category, 'data-pagefind-filter': 'tag' }}
	class="content-column mb-4"
	data-nosnippet={true}
	data-pagefind-ignore={true}
	items={tagItems}
/>
