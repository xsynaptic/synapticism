---
import DividedItem from '#components/parts/divided-item.astro';
import LabeledSection from '#components/parts/labeled-section.astro';
import Link from '#components/parts/link.astro';
import ListRow from '#components/parts/list-row.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { createTagsByIdsFunction } from '#lib/collections/tags/tags-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { sortByContentCount } from '#lib/utils/collections.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	tagIds: Array<string> | undefined;
}

const { tagIds, ...props } = Astro.props;

const getTagsByIds = await createTagsByIdsFunction();

const tags = tagIds ? getTagsByIds(tagIds).sort(sortByContentCount) : undefined;
---

{
	tags && tags.length > 0 ? (
		<LabeledSection data-nosnippet data-pagefind-ignore label={t('section.tags')} {...props}>
			<ListRow>
				{tags.map((item) => (
					<DividedItem
						as="li"
						class:list={[
							'font-mono text-sm after:text-sm after:font-light',
							MicroformatClassNames.Category,
						]}
						data-pagefind-filter="tag"
					>
						<Link href={getContentUrl(item.collection, item.id)} linkColor="accent">
							{item.data.title}
						</Link>
					</DividedItem>
				))}
			</ListRow>
		</LabeledSection>
	) : undefined
}
