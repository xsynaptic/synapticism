---
import type { HTMLAttributes } from 'astro/types';

import ProseDescription from '#components/parts/prose-description.astro';
import { renderSlot } from '#lib/utils/astro.ts';

type Props = HTMLAttributes<'div'>;

const { class: className, ...props } = Astro.props;

const description = await renderSlot(Astro.slots, 'section-description');
const children = await renderSlot(Astro.slots, 'default');
---

{description || children ? (
	<div class:list={['content-column mb-8', className]} {...props}>
		{description ? (
			<header>
				<ProseDescription class:list={['mb-4']}>
					<Fragment set:html={description} />
				</ProseDescription>
			</header>
		) : undefined}
		<Fragment set:html={children} />
	</div>
) : undefined}
