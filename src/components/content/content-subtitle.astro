---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
	html: string;
}

const { html, ...props } = Astro.props;
---

<div
	class="items-center gap-1 pt-2 anchor-ink-muted text-xs text-primary-500 sm:flex sm:flex-wrap"
	set:html={html}
	{...props}
/>
