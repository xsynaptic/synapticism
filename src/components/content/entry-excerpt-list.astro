---
import type { CollectionEntry } from 'astro:content';

import type { Pagination } from '#lib/utils/pagination-types.ts';

import EntryExcerpt from '#components/content/entry-excerpt.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { MicroformatClassNames } from '#components/types.ts';

interface Props {
	entries: Array<CollectionEntry<'posts' | 'projects'>>;
	isCollectionShown?: boolean;
	isLeading?: boolean;
	pagination: Pagination;
}

const { entries, isCollectionShown = false, isLeading = false, pagination } = Astro.props;
---

<div class:list={[MicroformatClassNames.Feed, 'scroll-mt-4']} data-pagination-target>
	{entries.map((entry, index) => (
		<Fragment>
			{index > 0 ? (
				<div class="content-column my-8">
					<hr class="border-primary-300/70" />
				</div>
			) : undefined}
			<EntryExcerpt
				entry={entry}
				isCollectionShown={isCollectionShown}
				isLeading={isLeading && index === 0}
				isPriority={index === 0}
			/>
		</Fragment>
	))}
</div>
<div class="content-column">
	<PaginationSelect class="mt-8" pagination={pagination} />
</div>
