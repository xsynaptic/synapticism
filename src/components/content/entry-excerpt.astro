---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import ContentExcerpt from '#components/content/content-excerpt.astro';
import ContentHero from '#components/content/content-hero.astro';
import EntrySubtitle from '#components/content/entry-subtitle.astro';
import { getImageFeaturedHeroGroup } from '#lib/utils/image-featured.ts';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props {
	class?: string | undefined;
	entry: CollectionEntry<'posts' | 'projects'>;
	isCollectionShown: boolean;
	isLeading: boolean;
	isPriority: boolean;
}

const { class: className, entry, isCollectionShown, isLeading, isPriority } = Astro.props;

const { Content } = await render(entry);

const heroImage = getImageFeaturedHeroGroup({ imageFeatured: entry.data.imageFeatured })?.[0];
---

<ContentExcerpt
	class={className}
	entryUrl={getContentPath(entry.collection, entry.id)}
	isLeading={isLeading}
>
	<Fragment slot="excerpt-title">{entry.data.title}</Fragment>
	<EntrySubtitle entry={entry} isCollectionShown={isCollectionShown} slot="excerpt-subtitle" />
	{heroImage ? (
		<ContentHero
			{...heroImage}
			fallbackAlt={entry.data.title}
			isPriority={isPriority}
			slot="excerpt-hero"
			template="sidebar"
		/>
	) : undefined}
	<Content />
</ContentExcerpt>
