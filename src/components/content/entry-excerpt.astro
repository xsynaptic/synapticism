---
import type { CollectionEntry } from 'astro:content';

import { getImageFeaturedItems } from '@synapticism/shared/image-featured';
import { render } from 'astro:content';

import ContentExcerpt from '#components/content/content-excerpt.astro';
import EntrySubtitle from '#components/content/entry-subtitle.astro';
import ImageCarousel from '#components/image/image-carousel.astro';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props {
	class?: string | undefined;
	entry: CollectionEntry<'posts' | 'projects'>;
	isCollectionShown: boolean;
	isLeading: boolean;
	isPriority: boolean;
}

const { class: className, entry, isCollectionShown, isLeading, isPriority } = Astro.props;

Astro.locals.isExcerpt = true;

const { Content } = await render(entry);

const images = getImageFeaturedItems(entry.data.imageFeatured);
---

<ContentExcerpt
	class={className}
	entryUrl={getContentPath(entry.collection, entry.id)}
	isLeading={isLeading}
>
	<Fragment slot="excerpt-title">{entry.data.title}</Fragment>
	<EntrySubtitle entry={entry} isCollectionShown={isCollectionShown} slot="excerpt-subtitle" />
	{images.length > 0 ? (
		<ImageCarousel images={images} isPriority={isPriority} slot="excerpt-media" />
	) : undefined}
	<Content />
</ContentExcerpt>
