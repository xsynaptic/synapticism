---
import type { CollectionEntry } from 'astro:content';

import type { Pagination } from '#lib/utils/pagination-types.ts';

import PostExcerpt from '#components/content/post-excerpt.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { MicroformatClassNames } from '#components/types.ts';

interface Props {
	entries: Array<CollectionEntry<'posts'>>;
	pagination: Pagination;
}

const { entries, pagination } = Astro.props;
---

<div class:list={[MicroformatClassNames.Feed, 'scroll-mt-4']} data-pagination-target>
	{entries.map((entry, index) => (
		<Fragment>
			{index > 0 ? (
				<div class="content-column my-8">
					<hr class="border-primary-300/70" />
				</div>
			) : undefined}
			<PostExcerpt entry={entry} isPriority={index === 0} />
		</Fragment>
	))}
</div>
<div class="content-column">
	<PaginationSelect class="mt-8" pagination={pagination} />
</div>
