---
import type { CollectionEntry } from 'astro:content';

import ContentDate from '#components/content/content-date.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	entry: CollectionEntry<'posts'>;
	minutesRead: number | undefined;
}

const { entry, minutesRead } = Astro.props;
---

<ContentDate dateCreated={entry.data.dateCreated} dateUpdated={entry.data.dateUpdated} />
{minutesRead ? (
	<DividedItem>{formatStringTemplate(t('content.minutesRead'), { minutesRead })}</DividedItem>
) : undefined}
