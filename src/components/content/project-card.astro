---
import type { CollectionEntry } from 'astro:content';

import { getImageFeaturedItems } from '@synapticism/shared/image-featured';

import ContentCard from '#components/content/content-card.astro';
import ContentContinueReading from '#components/content/content-continue-reading.astro';
import EntrySubtitle from '#components/content/entry-subtitle.astro';
import ImageCarousel from '#components/image/image-carousel.astro';
import { listTagLimit, projectImageAspectRatio } from '#constants.ts';
import { getTagChipItems } from '#lib/collections/tags/tags-utils.ts';
import { getDescriptionRenderedHtml } from '#lib/utils/description-data.ts';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props {
	class?: string | undefined;
	entry: CollectionEntry<'projects'>;
	isPriority: boolean;
}

const { class: className, entry, isPriority } = Astro.props;

const { data } = entry;

const url = getContentPath('projects', entry.id);
const isFeatured = data.featuredOrder !== undefined;
const images = getImageFeaturedItems(data.imageFeatured);
const aspectRatioStyle = `aspect-ratio:${String(projectImageAspectRatio.width)}/${String(projectImageAspectRatio.height)}`;
---

<ContentCard
	class={className}
	description={getDescriptionRenderedHtml(entry)}
	tagItems={await getTagChipItems(data.tags, { limit: listTagLimit })}
	title={data.title}
	url={url}
>
	{isFeatured && images.length > 0 ? (
		<ImageCarousel
			aspectRatio={projectImageAspectRatio}
			images={images}
			isPriority={isPriority}
			slot="card-media"
		/>
	) : undefined}
	{isFeatured && images.length === 0 ? (
		<div
			aria-hidden="true"
			class="rounded-xs border border-primary-300 bg-primary-200"
			slot="card-media"
			style={aspectRatioStyle}
		/>
	) : undefined}
	<EntrySubtitle entry={entry} slot="card-subtitle" />
	{isFeatured ? <ContentContinueReading href={url} slot="card-links" /> : undefined}
</ContentCard>
