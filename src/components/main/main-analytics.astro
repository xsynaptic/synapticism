---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'script'> {
	isViewTransitionsEnabled: boolean;
	umamiDomain: string;
	umamiId: string;
}

const { isViewTransitionsEnabled, umamiDomain, umamiId, ...props } = Astro.props;
---

<script
	data-website-id={umamiId}
	defer
	src={`${umamiDomain}/script.js`}
	{...props}
	{...isViewTransitionsEnabled ? { 'data-astro-rerun': '' } : {}}
	is:inline></script>
