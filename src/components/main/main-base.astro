---
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID } from 'astro:env/client';
import { ClientRouter } from 'astro:transitions';

import UmamiAnalytics from '#components/parts/umami-analytics.astro';
import '#styles/global.css';
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width,initial-scale=1" name="viewport" />
		<link href={`/favicon.svg`} rel="icon" type="image/svg+xml" />
		<Font cssVariable="--font-aleo" preload />
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-geist-mono" preload />
		<Font cssVariable="--font-ibm-plex-sans" />
		<ClientRouter />
		<UmamiAnalytics
			id={UMAMI_ID}
			domain={UMAMI_DOMAIN}
			isProduction={import.meta.env.PROD}
			isViewTransitionsEnabled={true}
		/>
	</head>
	<body
		class:list={[
			'flex min-h-screen min-w-[350px] flex-col overscroll-contain',
			'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-400',
		]}
	>
		<slot />
	</body>
</html>
