---
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getSitePath } from '#lib/utils/routing.ts';
---

<p class="mb-4 max-w-[60ch] text-sm leading-relaxed text-pretty text-primary-600">
	{t('footer.bio')}{' '}
	<Anchor anchorColor="accent" href={getSitePath('about')}>
		{t('footer.about')}
	</Anchor>
	<span aria-hidden="true" class="ml-0.5 text-primary-600">
		&rarr;
	</span>
</p>
