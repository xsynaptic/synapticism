---
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getCopyrightYears } from '#lib/utils/date.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

const copyrightYears = getCopyrightYears();
---

<div class="flex flex-wrap items-center gap-x-1 text-xs text-primary-600">
	<DividedItem as="span">
		{formatStringTemplate(t('footer.copyright'), { years: copyrightYears })}
	</DividedItem>
	<DividedItem as="span">
		{t('footer.builtWith')}{' '}
		<Anchor anchorColor="primary-bright" href="https://astro.build">
			{t('footer.astro')}
		</Anchor>
	</DividedItem>
	<DividedItem as="span">
		<Anchor anchorColor="primary-bright" href="https://github.com/xsynaptic/synapticism">
			{t('footer.sourceCode')}
		</Anchor>
	</DividedItem>
	<DividedItem as="span">
		<Anchor
			anchorColor="primary-bright"
			class="group inline-flex items-center gap-1.5"
			data-astro-prefetch="false"
			href={`${getSitePath()}rss.xml`}
			rel="feed"
		>
			<span>{t('footer.rss')}</span>
			<span class="relative size-2.5 bg-white">
				<svg
					aria-hidden="true"
					class="absolute top-1/2 left-1/2 size-4 -translate-1/2 text-highlight-400 transition-colors duration-300 group-hover:text-highlight-300 group-focus-visible:text-highlight-300"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2m2.5 12A1.5 1.5 0 0 0 6 16.5A1.5 1.5 0 0 0 7.5 18A1.5 1.5 0 0 0 9 16.5A1.5 1.5 0 0 0 7.5 15M6 10v2a6 6 0 0 1 6 6h2a8 8 0 0 0-8-8m0-4v2a10 10 0 0 1 10 10h2A12 12 0 0 0 6 6"
						fill="currentColor"
					></path>
				</svg>
			</span>
		</Anchor>
	</DividedItem>
</div>
