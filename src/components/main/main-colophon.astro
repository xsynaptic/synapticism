---
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getCopyrightYears } from '#lib/utils/date.ts';
import { getSiteUrl } from '#lib/utils/routing.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

const copyrightYears = getCopyrightYears();
---

<div class="flex flex-wrap items-center gap-x-1 text-xs text-primary-600">
	<DividedItem as="span" dividerContent="slash">
		{formatStringTemplate(t('footer.copyright'), { years: copyrightYears })}
	</DividedItem>
	<DividedItem as="span" dividerContent="slash">
		{t('footer.builtWith')}{' '}
		<Anchor anchorColor="primary-bright" href="https://astro.build">{t('footer.astro')}</Anchor>
	</DividedItem>
	<DividedItem as="span" dividerContent="slash">
		<Anchor anchorColor="primary-bright" href={`${getSiteUrl()}rss.xml`}>{t('footer.rss')}</Anchor>
	</DividedItem>
</div>
