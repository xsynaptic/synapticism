---
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getCopyrightYears } from '#lib/utils/date.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

const copyrightYears = getCopyrightYears();
---

<div class="flex flex-wrap items-center gap-x-1 text-xs text-primary-300">
	<DividedItem as="span">
		{formatStringTemplate(t('footer.copyright'), { years: copyrightYears })}
	</DividedItem>
	<DividedItem as="span">
		{t('footer.builtWith')}{' '}
		<Anchor anchorColor="on-dark" href="https://astro.build">
			{t('footer.astro')}
		</Anchor>
	</DividedItem>
	<DividedItem as="span">
		<Anchor
			anchorColor="on-dark"
			class="inline-flex items-center gap-1.5"
			href="https://github.com/xsynaptic/synapticism"
		>
			<span>{t('footer.sourceCode')}</span>
			<svg aria-hidden="true" class="text-primary-300" height="1em" width="1em">
				<use href="#icon:github"></use>
			</svg>
		</Anchor>
	</DividedItem>
	<DividedItem as="span">
		<Anchor
			anchorColor="on-dark"
			class="group inline-flex items-center gap-1.5"
			data-astro-prefetch="false"
			href={`${getSitePath()}rss.xml`}
			rel="feed"
		>
			<span>{t('footer.rss')}</span>
			<span class="relative size-2.5 bg-white">
				<svg
					aria-hidden="true"
					class="absolute top-1/2 left-1/2 size-4 -translate-1/2 text-highlight-400 transition-colors group-hover:text-highlight-300 group-focus-visible:text-highlight-300"
				>
					<use href="#icon:rss"></use>
				</svg>
			</span>
		</Anchor>
	</DividedItem>
</div>
