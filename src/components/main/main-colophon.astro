---
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getCopyrightYears } from '#lib/utils/date.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

const copyrightYears = getCopyrightYears();
---

<div class="flex flex-wrap items-center gap-x-1 text-xs text-primary-300">
	<DividedItem as="span">
		{formatStringTemplate(t('footer.copyright'), { years: copyrightYears })}
	</DividedItem>
	<DividedItem as="span">
		<span>
			{t('footer.builtWith')}{' '}
			<Anchor href="https://astro.build" underline="hover">
				{t('footer.astro')}
			</Anchor>
		</span>
	</DividedItem>
	<DividedItem as="span">
		<Anchor href="https://github.com/xsynaptic/synapticism" underline="hover">
			{t('footer.sourceCode')}
			<svg aria-hidden="true" class="text-primary-300" height="1em" slot="end" width="1em">
				<use href="#icon:github"></use>
			</svg>
		</Anchor>
	</DividedItem>
	<DividedItem as="span">
		<Anchor
			class="group"
			data-astro-prefetch="false"
			href={`${getSitePath()}rss.xml`}
			rel="feed"
			underline="hover"
		>
			{t('footer.rss')}
			<span class="relative size-2.5 bg-white" slot="end">
				<svg
					aria-hidden="true"
					class="absolute top-1/2 left-1/2 size-4 -translate-1/2 text-highlight-400 transition-colors group-hover:text-highlight-300 group-focus-visible:text-highlight-300"
				>
					<use href="#icon:rss"></use>
				</svg>
			</span>
		</Anchor>
	</DividedItem>
</div>
