---
import Container from '#components/parts/container.astro';
import Link from '#components/parts/link.astro';
import { getSiteUrl } from '#lib/utils/routing.ts';

const siteUrl = getSiteUrl();
---

<header class:list={['transition-colors', 'z-40', 'bg-zinc-100 dark:bg-zinc-800']}>
	<div class="pt-2 pb-1">
		<Container as="h2" class="flex flex-wrap items-center justify-between gap-2">
			<Link
				href={siteUrl}
				class="font-sans text-xl font-semibold md:text-2xl lg:text-3xl"
				linkColor="primary">Synapticism</Link
			>
		</Container>
	</div>
	<nav class="py-1">
		<Container as="ul" class="flex items-end gap-2">
			<li><Link href="/posts" linkColor="secondary">Posts</Link></li>
			<li><Link href="/projects" linkColor="secondary">Projects</Link></li>
			<li><Link href="/about" linkColor="secondary">About</Link></li>
		</Container>
	</nav>
</header>
