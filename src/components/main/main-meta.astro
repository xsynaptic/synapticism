---
import { openGraphImageHeight, openGraphImageWidth } from '@synapticism/shared/constants';
import { SEO } from 'astro-seo';
import { WEBMENTION_DOMAIN } from 'astro:env/client';

import type { MetaProps } from '#components/types.ts';

import { t } from '#lib/i18n/i18n-strings.ts';
import { getBasePath } from '#lib/utils/routing.ts';
import { getOpenGraphImageUrl } from '#lib/utils/seo.ts';
import { formatStringTemplate, sanitizeAltAttribute } from '#lib/utils/text.ts';

type Props = MetaProps;

const {
	article,
	description: descriptionRaw,
	noFollow,
	noIndex,
	ogType,
	openGraphId,
	prefetchUrls,
	title: contentTitle,
} = Astro.props;

const siteTitle = t('site.title');
const siteDescription = t('site.description');

const description = descriptionRaw ?? siteDescription;

// The card draws the title, not the description
const openGraphImage = {
	alt: sanitizeAltAttribute(contentTitle ?? siteTitle),
	height: openGraphImageHeight,
	type: 'image/jpeg',
	url: getOpenGraphImageUrl(openGraphId),
	width: openGraphImageWidth,
};
---

<SEO
	description={description}
	extend={{
		...(prefetchUrls && prefetchUrls.length > 0
			? { link: prefetchUrls.map((prefetchUrl) => ({ href: prefetchUrl, rel: 'prefetch' })) }
			: {}),
		meta: [{ content: Astro.generator, name: 'generator' }],
	}}
	openGraph={{
		basic: {
			image: openGraphImage.url,
			title: contentTitle
				? formatStringTemplate(t('site.pageTitle'), { siteTitle, title: contentTitle })
				: siteTitle,
			type: ogType ?? 'website',
		},
		image: openGraphImage,
		optional: {
			description,
		},
		...(ogType === 'article' && article !== undefined ? { article } : {}),
	}}
	title={contentTitle ?? siteTitle}
	titleDefault={siteTitle}
	titleTemplate={!!contentTitle && contentTitle !== siteTitle ? `%s - ${siteTitle}` : '%s'}
	twitter={{
		card: 'summary_large_image',
		description,
		image: openGraphImage.url,
		imageAlt: openGraphImage.alt,
		title: contentTitle ?? siteTitle,
	}}
	{...(noIndex ? { noindex: noIndex } : {})}
	{...(noFollow ? { nofollow: noFollow } : {})}
/>
<link href={getBasePath('rss.xml')} rel="alternate" title={siteTitle} type="application/rss+xml" />
<link href={getBasePath('sitemap-index.xml')} rel="sitemap" />
{WEBMENTION_DOMAIN ? (
	<link href={`https://webmention.io/${WEBMENTION_DOMAIN}/webmention`} rel="webmention" />
) : undefined}
