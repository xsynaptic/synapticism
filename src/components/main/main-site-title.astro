---
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getSitePath } from '#lib/utils/routing.ts';

interface Props {
	isHomepage: boolean;
}

const { isHomepage } = Astro.props;

// The site title is the page h1 on the homepage and its later pages, plain branding elsewhere
const SiteTitleTag = isHomepage ? 'h1' : 'div';
---

<SiteTitleTag class="font-display text-sm font-semibold tracking-widest uppercase">
	<span class="text-primary-500">ꗥ</span>{' '}
	<Anchor href={getSitePath()} underline="none">
		{t('site.title')}
	</Anchor>
</SiteTitleTag>
