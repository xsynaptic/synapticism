---
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID } from 'astro:env/client';
import { ClientRouter } from 'astro:transitions';

import type { MetaProps } from '#components/types.ts';
import type { Thing } from '#lib/utils/structured-data.ts';

import '#styles/main.css';
import Analytics from '#components/main/main-analytics.astro';
import Colophon from '#components/main/main-colophon.astro';
import Meta from '#components/main/main-meta.astro';
import SkipLink from '#components/main/main-skip-link.astro';
import StructuredData from '#components/main/main-structured-data.astro';
import TopButton from '#components/main/main-top-button.astro';
import MenuFooter from '#components/menu/menu-footer.astro';
import MenuHeader from '#components/menu/menu-header.astro';
import Anchor from '#components/parts/anchor.astro';
import ProgressReading from '#components/progress/progress-reading.astro';
import Search from '#components/search/search.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getSiteUrl } from '#lib/utils/routing.ts';

interface Props {
	hasReadingBar?: boolean;
	isHomepage?: boolean;
	meta?: MetaProps;
	schemas?: Array<Thing>;
}

const { hasReadingBar = false, isHomepage = false, meta, schemas } = Astro.props;

const siteUrl = getSiteUrl();

// The site title is the page h1 on the homepage/stream, plain branding elsewhere
const SiteTitleTag = isHomepage ? 'h1' : 'div';
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width,initial-scale=1" name="viewport" />
		<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
		<Font cssVariable="--font-aleo" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-geist-mono" preload />
		<Meta {...meta} />
		{
			UMAMI_ID && UMAMI_DOMAIN && import.meta.env.PROD ? (
				<Analytics isViewTransitionsEnabled={true} umamiDomain={UMAMI_DOMAIN} umamiId={UMAMI_ID} />
			) : undefined
		}
		<ClientRouter />
	</head>
	<body
		class:list={[
			'flex min-h-screen min-w-[350px] flex-col overscroll-contain',
			'bg-primary-800 text-primary-700',
			'print:min-h-0 print:bg-white',
		]}
	>
		<SkipLink
			class:list={[
				'rounded-br-sm px-4 py-1 uppercase',
				'bg-primary-50 text-accent-500 hover:text-accent-400 focus-visible:text-accent-400',
			]}
			label={t('site.skipToContent')}
			parentClass="print:hidden"
		/>
		<header class:list={['z-header', 'print:hidden']}>
			<div class:list={['py-3 lg:py-4', 'bg-linear-to-b from-primary-800 to-primary-700']}>
				<div class="content-column flex flex-wrap items-center justify-between gap-2">
					<SiteTitleTag class="font-sans text-sm font-semibold tracking-widest uppercase">
						<span class="text-primary-500">ꗥ</span>{' '}<Anchor
							anchorColor="on-dark"
							href={siteUrl}
						>
							{t('site.title')}
						</Anchor>
					</SiteTitleTag>
					<Search />
				</div>
			</div>
			<MenuHeader />
		</header>
		<main
			class="flex-1 bg-linear-to-b from-primary-200 to-primary-100 to-[150px] pb-8 print:bg-none"
			id="main-content"
		>
			<slot />
		</main>
		<footer
			class="border-t border-primary-300 bg-linear-to-b from-primary-200 to-primary-100 pt-4 print:hidden"
			data-nosnippet
		>
			<div class="content-column pb-8">
				<MenuFooter />
				<Colophon />
			</div>
		</footer>
		{
			hasReadingBar ? (
				<ProgressReading
					class:list={[
						'z-progress rounded-br-md shadow-lg shadow-current',
						'bg-linear-to-r from-highlight-500 to-highlight-300 text-highlight-200',
						'print:hidden',
					]}
					height="2.5px"
				/>
			) : undefined
		}
		<TopButton />
		{schemas && schemas.length > 0 ? <StructuredData schemas={schemas} /> : undefined}
	</body>
</html>
