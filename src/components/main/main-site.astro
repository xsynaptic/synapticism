---
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID } from 'astro:env/client';
import { ClientRouter } from 'astro:transitions';

import type { MetaProps } from '#components/types.ts';
import type { Template } from '#lib/schemas/content.ts';
import type { Thing } from '#lib/utils/structured-data.ts';

import '#styles/main.css';
import Analytics from '#components/main/main-analytics.astro';
import AsideSection from '#components/main/main-aside-section.astro';
import Bio from '#components/main/main-bio.astro';
import Colophon from '#components/main/main-colophon.astro';
import Meta from '#components/main/main-meta.astro';
import RecentActivity from '#components/main/main-recent-activity.astro';
import SiteTitle from '#components/main/main-site-title.astro';
import SkipLink from '#components/main/main-skip-link.astro';
import Sprites from '#components/main/main-sprites.astro';
import TopButton from '#components/main/main-top-button.astro';
import NavigationFooter from '#components/navigation/navigation-footer.astro';
import NavigationHeader from '#components/navigation/navigation-header.astro';
import ProgressLoading from '#components/progress/progress-loading.astro';
import ProgressReading from '#components/progress/progress-reading.astro';
import SearchModal from '#components/search/search-modal.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { serializeGraph } from '#lib/utils/structured-data.ts';

interface Props {
	hasReadingBar?: boolean;
	isHomepage?: boolean;
	meta?: MetaProps;
	schemas?: Array<Thing>;
	template?: Template;
}

const {
	hasReadingBar = false,
	isHomepage = false,
	meta,
	schemas,
	template = 'sidebar',
} = Astro.props;

const isSidebar = template === 'sidebar';

const columnClass = isSidebar ? 'sidebar-column' : 'content-column';

// Tracks --color-primary-800, the band behind the header
const themeColor = '#23272f';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width,initial-scale=1" name="viewport" />
		<meta content="light" name="color-scheme" />
		<meta content={themeColor} name="theme-color" />
		<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
		<Font cssVariable="--font-aleo" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-red-hat-text" preload={[{ style: 'normal', weight: 400 }]} />
		<Font cssVariable="--font-red-hat-mono" />
		<slot name="head" />
		<Meta {...meta} />
		{UMAMI_ID && UMAMI_DOMAIN && import.meta.env.PROD ? (
			<Analytics umamiDomain={UMAMI_DOMAIN} umamiId={UMAMI_ID} />
		) : undefined}
		<ClientRouter />
		<meta content={import.meta.env.BUILD_VERSION} name="build-version" />
		<script is:inline>
			// A session older than the deploy soft-navigates onto hashed chunks Cloudflare no longer serves
			(() => {
				const version = document.querySelector('meta[name="build-version"]')?.content;
				if (!version) return;
				document.addEventListener('astro:before-swap', (event) => {
					const next = event.newDocument.querySelector('meta[name="build-version"]')?.content;
					if (next && next !== version) window.location.assign(event.to.href);
				});
			})();
		</script>
	</head>
	<body
		class:list={[
			'flex min-h-screen min-w-site-min flex-col overscroll-contain',
			'bg-primary-800 text-primary-700',
			'print:min-h-0 print:bg-white',
		]}
	>
		<Sprites />
		<ProgressLoading
			class:list={[
				'z-progress-loading rounded-br-md shadow-lg shadow-current',
				'bg-linear-to-r from-highlight-500 to-highlight-300 text-highlight-200',
				'print:hidden',
			]}
			height="2.5px"
		/>
		<SkipLink
			class:list={[
				'rounded-br-sm px-4 py-1 uppercase',
				'bg-primary-50 text-accent-500 hover:text-accent-400 focus-visible:text-accent-400',
			]}
			label={t('site.skipToContent')}
			parentClass="print:hidden"
		/>
		<div
			class:list={[
				'site-shell grid flex-1 bg-primary-500',
				{ 'site-shell-sidebar': isSidebar },
				'print:block print:bg-none',
			]}
		>
			<header
				class:list={[
					'anchor-ink-on-dark z-header',
					{ 'lg:col-start-3 lg:row-start-1': isSidebar },
					'print:hidden',
				]}
			>
				<div
					class:list={[
						'py-3 lg:flex lg:h-site-title lg:items-center lg:py-0',
						'bg-linear-to-b from-primary-800 to-primary-700',
					]}
				>
					<div class={columnClass}>
						<SiteTitle isHomepage={isHomepage} />
					</div>
				</div>
				<NavigationHeader columnClass={columnClass} />
			</header>
			<main
				class:list={[
					'site-shell-main flex flex-col pb-8',
					{ 'lg:col-start-2 lg:row-span-2 lg:row-start-1': isSidebar },
					'print:block print:bg-none',
				]}
				id="main-content"
			>
				<slot />
			</main>
			<aside
				class:list={[
					'site-shell-aside anchor-ink-on-dark pt-6 pb-6',
					{ 'lg:col-start-3 lg:row-start-2': isSidebar },
					'print:hidden',
				]}
				data-nosnippet
			>
				<div
					class:list={[columnClass, 'grid gap-8 md:grid-cols-2', { 'lg:grid-cols-1': isSidebar }]}
				>
					<AsideSection title={t('aside.recentActivity')}>
						<RecentActivity />
					</AsideSection>
					<AsideSection title={t('aside.about')}>
						<Bio />
						<NavigationFooter />
					</AsideSection>
				</div>
			</aside>
			<footer
				class:list={[
					'anchor-ink-on-dark grid min-h-site-nav items-center bg-linear-to-b from-primary-700 to-primary-800 py-2',
					{ 'lg:col-span-full lg:grid lg:grid-cols-subgrid': isSidebar },
					'print:hidden',
				]}
				data-nosnippet
			>
				<div class:list={['content-column', { 'lg:col-start-2': isSidebar }]}>
					<Colophon />
				</div>
			</footer>
		</div>
		{hasReadingBar ? (
			<ProgressReading
				class:list={[
					'z-progress rounded-br-md shadow-lg shadow-current',
					'bg-linear-to-r from-highlight-500 to-highlight-300 text-highlight-200',
					'print:hidden',
				]}
				height="2.5px"
			/>
		) : undefined}
		<TopButton />
		<SearchModal />
		{schemas && schemas.length > 0 ? (
			<script is:inline set:html={serializeGraph(schemas)} type="application/ld+json"></script>
		) : undefined}
	</body>
</html>
