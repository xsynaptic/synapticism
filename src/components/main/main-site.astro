---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import type { MetaProps } from '#components/types.ts';
import type { Thing } from '#lib/utils/structured-data.ts';

import Analytics from '#components/main/main-analytics.astro';
import Colophon from '#components/main/main-colophon.astro';
import Meta from '#components/main/main-meta.astro';
import SkipLink from '#components/main/main-skip-link.astro';
import Stylesheet from '#components/main/main-stylesheet.astro';
import MenuFooter from '#components/menu/menu-footer.astro';
import MenuHeader from '#components/menu/menu-header.astro';
import Container from '#components/parts/container.astro';
import Link from '#components/parts/link.astro';
import ProgressReading from '#components/progress/progress-reading.astro';
import { getSiteUrl } from '#lib/utils/routing.ts';
import { serializeGraph } from '#lib/utils/structured-data.ts';

interface Props {
	hasReadingBar?: boolean;
	meta?: MetaProps;
	schemas?: Array<Thing>;
}

const { hasReadingBar = false, meta, schemas } = Astro.props;

const siteUrl = getSiteUrl();
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width,initial-scale=1" name="viewport" />
		<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
		<Stylesheet />
		<Font cssVariable="--font-aleo" preload />
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-geist-mono" preload />
		<Meta {...meta} />
		<Analytics isViewTransitionsEnabled={true} />
		<ClientRouter />
	</head>
	<body
		class:list={[
			'flex min-h-screen min-w-[350px] flex-col overscroll-contain',
			'bg-primary-100 text-primary-700',
		]}
	>
		<SkipLink label="Skip to content" />
		<header class:list={['transition-colors', 'z-40']}>
			<div class:list={['py-3 lg:py-4', 'bg-primary-800']}>
				<Container class="flex flex-wrap items-center justify-between gap-2">
					<h2>
						<Link
							class="font-sans text-xl font-semibold md:text-2xl lg:text-3xl"
							href={siteUrl}
							linkColor="on-dark"
						>
							Synapticism
						</Link>
					</h2>
					<div class="relative" id="search"></div>
				</Container>
			</div>
			<MenuHeader />
		</header>
		<main class="flex-1" id="main-content">
			<slot />
		</main>
		<footer class="border-t border-primary-200 pt-small" data-nosnippet>
			<Container class="pb-medium">
				<MenuFooter />
				<Colophon />
			</Container>
		</footer>
		{
			hasReadingBar ? (
				<ProgressReading
					class:list={[
						'z-98 rounded-br-md shadow-lg shadow-current',
						'bg-linear-to-r from-accent-500 to-accent-300 text-accent-200',
					]}
					height="2.5px"
				/>
			) : undefined
		}
		{
			schemas && schemas.length > 0 ? (
				<script is:inline set:html={serializeGraph(schemas)} type="application/ld+json" />
			) : undefined
		}
	</body>
</html>
