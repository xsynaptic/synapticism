---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
	label: string;
	parentClass?: string | undefined;
	target?: string | undefined;
}

const { class: className, label, parentClass, target = '#main-content', ...props } = Astro.props;
---

<div class:list={['skip-link', parentClass]} {...props}>
	<a
		class:list={[
			'absolute z-skip-link hover:outline-2 hover:outline-current focus-visible:outline-2 focus-visible:outline-current',
			className,
		]}
		href={target}>{label}</a
	>
</div>
