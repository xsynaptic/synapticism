---
import type { Thing } from '#lib/utils/structured-data.ts';

import { serializeGraph } from '#lib/utils/structured-data.ts';

interface Props {
	schemas: Array<Thing>;
}

const { schemas } = Astro.props;

// This file is prettier-ignored; the plugin self-closes set:html elements, invalid for a raw-text tag
---

<script is:inline set:html={serializeGraph(schemas)} type="application/ld+json"></script>
