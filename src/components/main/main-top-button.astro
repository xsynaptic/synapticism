---
import { t } from '#lib/i18n/i18n-strings.ts';
---

<top-button
	class="fixed right-2 bottom-2 z-top-button flex cursor-pointer items-center justify-center rounded-full border border-primary-200 bg-primary-50 shadow-lg focus-within:bg-primary-100 hover:bg-primary-100 sm:hidden print:hidden"
	inert
>
	<button
		aria-label={t('site.topButton')}
		class="flex p-3 text-primary-600 transition-colors duration-200 hover:text-accent-500 focus-visible:text-accent-500"
		type="button"
	>
		<svg
			aria-hidden="true"
			fill="none"
			height="24"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			viewBox="0 0 24 24"
			width="24"
		>
			<path d="m18 15-6-6-6 6"></path>
		</svg>
	</button>
</top-button>

<script>
	import '#components/main/main-top-button.ts';
</script>
