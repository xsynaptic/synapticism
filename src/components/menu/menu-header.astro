---
import type { HTMLAttributes } from 'astro/types';

import { menuHeaderItems } from '#components/menu/menu-header.ts';
import { isActiveMenuItem } from '#components/menu/menu-utils.ts';
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

type Props = HTMLAttributes<'nav'>;

const props = Astro.props;

const { pathname } = Astro.url;
---

<nav
	aria-label={t('aria.mainNav')}
	class="border-b border-accent-600 bg-linear-to-b from-accent-600 to-accent-500 py-2"
	{...props}
>
	<ul class="mx-auto flex max-w-content items-center gap-4 px-4 md:px-8">
		{
			menuHeaderItems.map((item) => {
				const isActive = isActiveMenuItem(item, pathname);

				return (
					<li>
						<Anchor
							aria-current={isActive ? 'page' : undefined}
							class:list={[
								'text-sm underline decoration-2 underline-offset-4 sm:text-base',
								isActive
									? 'font-semibold decoration-white/55'
									: 'font-medium decoration-transparent hover:decoration-white/55 focus-visible:decoration-white/55',
							]}
							href={item.url}
							linkColor="on-accent"
						>
							{item.title}
						</Anchor>
					</li>
				);
			})
		}
	</ul>
</nav>
