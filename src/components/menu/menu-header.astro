---
import type { HTMLAttributes } from 'astro/types';

import { menuHeaderItems } from '#components/menu/menu-header.ts';
import { isActiveMenuItem } from '#components/menu/menu-utils.ts';
import Link from '#components/parts/link.astro';

type Props = HTMLAttributes<'nav'>;

const props = Astro.props;

const { pathname } = Astro.url;
---

<nav class="bg-accent-600 py-2" aria-label="Main navigation" {...props}>
	<ul class="mx-auto flex max-w-content items-center gap-4 px-small md:px-medium">
		{
			menuHeaderItems.map((item) => {
				const isActive = isActiveMenuItem(item, pathname);

				return (
					<li>
						<Link
							linkColor="on-accent"
							class:list={[
								'text-sm sm:text-base',
								isActive
									? 'font-semibold underline decoration-2 underline-offset-4'
									: 'font-medium',
							]}
							href={item.url}
							aria-current={isActive ? 'page' : undefined}
						>
							{item.title}
						</Link>
					</li>
				);
			})
		}
	</ul>
</nav>
