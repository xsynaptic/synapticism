---
import type { HTMLAttributes } from 'astro/types';

import { navigationHeaderItems } from '#components/navigation/navigation-header.ts';
import { isActiveNavigationItem } from '#components/navigation/navigation-utils.ts';
import SearchToggle from '#components/search/search-toggle.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props extends HTMLAttributes<'nav'> {
	columnClass?: 'content-column' | 'sidebar-column';
}

const { columnClass = 'content-column', ...props } = Astro.props;

const { pathname } = Astro.url;
---

<nav
	aria-label={t('aria.headerNavigation')}
	class:list={[
		'h-site-nav border-b border-accent-600 bg-linear-to-b from-accent-600 to-accent-500',
		'lg:border-b-0',
	]}
	{...props}
>
	<ul class:list={[columnClass, 'flex h-full gap-4 font-display']}>
		{navigationHeaderItems.map((item) => {
			const isActive = isActiveNavigationItem(item, pathname);

			return (
				<li class="flex">
					<a
						aria-current={isActive ? 'page' : undefined}
						class:list={[
							'navigation-header-link flex items-end pb-site-nav-baseline text-sm sm:text-base',
							isActive ? 'font-semibold' : 'font-medium',
						]}
						href={item.url}
					>
						<span class="trim-text">{item.title}</span>
					</a>
				</li>
			);
		})}
		<li class="ml-auto flex items-center">
			<SearchToggle />
		</li>
	</ul>
</nav>
