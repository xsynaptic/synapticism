---
import { t } from '#lib/i18n/i18n-strings.ts';
---

<path-suggestions
	class="block"
	link-class="anchor anchor-primary"
	link-data-astro-history="replace"
	src="/content-manifest.json"
>
	<p class="suggestions-heading text-primary-600">{t('notFound.suggestions')}</p>
	<p class="suggestions-loading text-primary-500">{t('notFound.suggestionsLoading')}</p>
</path-suggestions>

<script>
	import { navigate } from 'astro:transitions/client';
	import '@xsynaptic/path-suggestions/element';

	document.addEventListener('path-suggestions:redirect', (event) => {
		event.preventDefault();
		void navigate(event.detail.url, { history: 'replace' });
	});
</script>
