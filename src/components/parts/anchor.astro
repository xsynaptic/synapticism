---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
	accent?: boolean | undefined;
	href: string;
	underline?: 'always' | 'hover' | 'none' | undefined;
}

const { accent = false, class: className, href, underline = 'always', ...props } = Astro.props;

const hasIcon = Astro.slots.has('start') || Astro.slots.has('end');

const rendered = await Astro.slots.render('default');
const label = rendered.trim();
---

<a
	class:list={[
		'anchor',
		accent ? 'anchor-accent' : undefined,
		underline === 'always' ? undefined : `anchor-underline-${underline}`,
		hasIcon ? 'anchor-split' : undefined,
		className,
	]}
	href={href}
	{...props}
>
	{hasIcon ? (
		<Fragment>
			<slot name="start" />
			<span class="anchor-label" set:html={label} />
			<slot name="end" />
		</Fragment>
	) : (
		<Fragment set:html={label} />
	)}
</a>
