---
import type { HTMLAttributes } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
	accent?: boolean | undefined;
	href: string;
	underline?: 'always' | 'hover' | 'none' | undefined;
}

const { accent = false, class: className, href, underline = 'always', ...props } = Astro.props;

const start = await renderSlot(Astro.slots, 'start');
const end = await renderSlot(Astro.slots, 'end');
const label = await renderSlot(Astro.slots);

const hasIcon = Boolean(start) || Boolean(end);
---

<a
	class:list={[
		'anchor',
		accent ? 'anchor-accent' : undefined,
		underline === 'always' ? undefined : `anchor-underline-${underline}`,
		hasIcon ? 'anchor-split' : undefined,
		className,
	]}
	href={href}
	{...props}
>
	{hasIcon ? (
		<Fragment>
			{start ? <Fragment set:html={start} /> : undefined}
			<span class="anchor-label" set:html={label} />
			{end ? <Fragment set:html={end} /> : undefined}
		</Fragment>
	) : (
		<Fragment set:html={label} />
	)}
</a>
