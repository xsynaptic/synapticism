---
import type { HTMLAttributes } from 'astro/types';

import type { DatePreset } from '#lib/utils/date.ts';

import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum, hasUtcTime, parseContentDate } from '#lib/utils/date.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props extends HTMLAttributes<'time'> {
	date: Date | string;
	dateOptions?: Intl.DateTimeFormatOptions | undefined;
	datePreset?: DatePreset;
}

const datePresets = {
	[DatePresetEnum.Long]: {
		day: 'numeric',
		month: 'long',
		timeZone: 'UTC',
		year: 'numeric',
	},
	[DatePresetEnum.Short]: {
		day: '2-digit',
		month: '2-digit',
		timeZone: 'UTC',
		year: 'numeric',
	},
} satisfies Record<DatePreset, Intl.DateTimeFormatOptions>;

const timeOptions = {
	hour: '2-digit',
	hour12: false,
	minute: '2-digit',
	timeZone: 'UTC',
} satisfies Intl.DateTimeFormatOptions;

const { date, dateOptions, datePreset = DatePresetEnum.Long, ...props } = Astro.props;

const dateRaw = parseContentDate(date);

if (!dateRaw) throw new Error(`Invalid date: "${JSON.stringify(date)}"`);

const dateTimeAttribute = dateRaw.toISOString();

const dateDisplay = dateRaw.toLocaleDateString('en-US', {
	...datePresets[datePreset],
	...dateOptions,
});

const timeDisplay = hasUtcTime(dateRaw)
	? formatStringTemplate(t('content.timeUtc'), {
			time: dateRaw.toLocaleTimeString('en-US', timeOptions),
		})
	: undefined;

const dateTimeTemplate = t(
	datePreset === DatePresetEnum.Short ? 'content.dateTimeShort' : 'content.dateTime',
);

const dateTimeDisplay = timeDisplay
	? formatStringTemplate(dateTimeTemplate, { date: dateDisplay, time: timeDisplay })
	: dateDisplay;
---

<time datetime={dateTimeAttribute} {...props}>{dateTimeDisplay}</time>
