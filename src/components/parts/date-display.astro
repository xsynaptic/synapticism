---
import type { HTMLAttributes } from 'astro/types';

import type { DatePreset } from '#lib/utils/date.ts';

import { DatePresetEnum, hasUtcTime, parseContentDate } from '#lib/utils/date.ts';

interface Props extends HTMLAttributes<'time'> {
	date: Date | string;
	dateOptions?: Intl.DateTimeFormatOptions | undefined;
	datePreset?: DatePreset;
}

const datePresets = {
	[DatePresetEnum.Long]: {
		day: 'numeric',
		month: 'long',
		timeZone: 'UTC',
		year: 'numeric',
	},
	[DatePresetEnum.Short]: {
		day: '2-digit',
		month: '2-digit',
		timeZone: 'UTC',
		year: 'numeric',
	},
} satisfies Record<DatePreset, Intl.DateTimeFormatOptions>;

const timeOptions = {
	hour: '2-digit',
	hour12: false,
	minute: '2-digit',
	timeZone: 'UTC',
} satisfies Intl.DateTimeFormatOptions;

const { date, dateOptions, datePreset = DatePresetEnum.Long, ...props } = Astro.props;

const dateRaw = parseContentDate(date);

if (!dateRaw) throw new Error(`Invalid date: "${JSON.stringify(date)}"`);

const dateTimeAttribute = dateRaw.toISOString();

const dateDisplay = dateRaw.toLocaleDateString('en-US', {
	...datePresets[datePreset],
	...dateOptions,
});

const timeDisplay = hasUtcTime(dateRaw)
	? `${dateRaw.toLocaleTimeString('en-US', timeOptions)} UTC`
	: undefined;
---

<time datetime={dateTimeAttribute} {...props}
	>{timeDisplay ? `${dateDisplay} at ${timeDisplay}` : dateDisplay}</time
>
