---
import type { HTMLAttributes } from 'astro/types';

import Anchor from '#components/parts/anchor.astro';

interface Props extends HTMLAttributes<'section'> {
	as?: 'h2' | 'h3';
	href?: string | undefined;
	title: string;
}

const { as: Heading = 'h2', class: className, href, title, ...props } = Astro.props;
---

<section class:list={['content-column mb-4', className]} {...props}>
	<div class="mb-4 flex items-center gap-2">
		<Heading class="font-mono text-xs font-medium text-primary-600">
			{href ? (
				<Anchor href={href} underline="hover">
					{title}
				</Anchor>
			) : (
				title
			)}
		</Heading>
		<span aria-hidden="true" class="h-px flex-1 bg-primary-200"></span>
	</div>
	<slot />
</section>
