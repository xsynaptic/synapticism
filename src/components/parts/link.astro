---
import type { HTMLAttributes } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

const LinkColorEnum = {
	Primary: 'primary',
	PrimaryBright: 'primary-bright',
	Highlight: 'highlight',
	HighlightBright: 'highlight-bright',
	Accent: 'accent',
	AccentBright: 'accent-bright',
	OnDark: 'on-dark',
	OnAccent: 'on-accent',
} as const;

type LinkColor = (typeof LinkColorEnum)[keyof typeof LinkColorEnum];

interface Props extends HTMLAttributes<'a'> {
	linkColor?: LinkColor | undefined;
}

const { class: className, href, linkColor = LinkColorEnum.Primary, ...props } = Astro.props;

const children = await renderSlot(Astro.slots, 'default');
---

<a href={href} class:list={['link', `link-${linkColor}`, className]} {...props}
	><Fragment set:html={children} /></a
>
