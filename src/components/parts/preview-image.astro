---
import { getPlaceholder } from '@xsynaptic/astro-image-pipeline/node';
import { Image } from 'astro:assets';

import { MicroformatClassNames } from '#components/types.ts';
import { getMediaImage } from '#lib/utils/media.ts';

interface Props {
	imgAlt: string;
	showMicroformats?: boolean | undefined;
	src: string | undefined;
}

const { imgAlt, showMicroformats = false, src } = Astro.props;

const image = src ? getMediaImage(src) : undefined;
const placeholder =
	src && image
		? await getPlaceholder({ height: image.height, id: src, width: image.width })
		: undefined;
---

{image ? (
	<div
		class="aspect-square w-16 shrink-0 overflow-hidden rounded bg-primary-200 bg-placeholder md:w-20"
		style={placeholder ? `background-image:url(${placeholder})` : undefined}
	>
		<Image
			alt={imgAlt}
			class:list={[
				'h-full w-full object-cover',
				showMicroformats ? MicroformatClassNames.Photo : undefined,
			]}
			layout="none"
			src={image}
			width={160}
		/>
	</div>
) : undefined}
