---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
	frame?: 'bleed' | 'column';
}

const { class: className, frame = 'column', ...props } = Astro.props;
---

<div
	class:list={['prose-x', frame === 'bleed' ? 'prose-bleed' : 'content-column', className]}
	{...props}
>
	<slot />
</div>
