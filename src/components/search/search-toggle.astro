---
import type { HTMLAttributes } from 'astro/types';

import { sendEventAttributes } from '#lib/analytics/analytics-events.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import pagefindCssUrl from '#styles/pagefind-component.css?url';

type Props = HTMLAttributes<'div'>;

const { class: className, ...props } = Astro.props;
---

<script>
	import '#components/search/search-client.ts';
</script>

<search-toggle
	class:list={['flex cursor-pointer items-center justify-center rounded-full', className]}
	shortcut-description={t('site.search.toggle.shortcut')}
	stylesheet={pagefindCssUrl}
	{...props}
>
	<button
		aria-expanded="false"
		aria-haspopup="dialog"
		aria-label={t('site.search.toggle.label')}
		class="text-lg text-white"
		{...sendEventAttributes('search-open')}
		title={t('site.search.toggle.title')}
		type="button"
	>
		<svg aria-hidden="true" height="1em" width="1em">
			<use href="#icon:search"></use>
		</svg>
	</button>
</search-toggle>
