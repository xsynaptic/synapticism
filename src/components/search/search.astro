---
import type { HTMLAttributes } from 'astro/types';

import { t } from '#lib/i18n/i18n-strings.ts';
import pagefindCssUrl from '#styles/pagefind-component.css?url';

type Props = HTMLAttributes<'div'>;

const props = Astro.props;

const bundlePath = `${import.meta.env.BASE_URL}pagefind/`;

/** Note: the styles at the bottom apply before web component JS loads */
---

<script>
	import '#components/search/search-toggle.ts';

	// Clears the Pagefind registry on navigation so search-toggle's modal-trigger registrations don't pile up
	// Pagefind has no deregisterUtility; see search-toggle.ts
	document.addEventListener('astro:before-swap', () => {
		const modal = document.querySelector('pagefind-modal') as
			| (Element & {
					instance?: {
						components: Array<unknown>;
						componentsByType: Record<string, Array<unknown>>;
					};
			  })
			| null;
		const instance = modal?.instance;

		if (instance) {
			instance.components = [];
			instance.componentsByType = {};
		}
	});
</script>

<pagefind-config bundle-path={bundlePath} preload={false}></pagefind-config>

<search-toggle
	class:list={[
		'flex cursor-pointer items-center justify-center rounded-full opacity-60 transition-opacity hover:opacity-100',
	]}
	data-pagefind-css-url={pagefindCssUrl}
	{...props}
>
	<button
		aria-expanded="false"
		aria-haspopup="dialog"
		aria-label={t('site.search.toggle.label')}
		class="text-white"
		data-umami-event="search-open"
		title={t('site.search.toggle.title')}
	>
		<svg
			aria-hidden="true"
			height="24"
			viewBox="0 0 24 24"
			width="24"
			xmlns="http://www.w3.org/2000/svg"
			><g
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				><circle cx="11" cy="11" r="8"></circle><path d="m21 21l-4.35-4.35"></path></g
			></svg
		>
	</button>
</search-toggle>
<pagefind-modal reset-on-close={true}>
	<pagefind-modal-header>
		<pagefind-input placeholder={t('site.search.placeholder')}></pagefind-input>
	</pagefind-modal-header>
	<pagefind-modal-body>
		<pagefind-summary></pagefind-summary>
		<pagefind-results></pagefind-results>
	</pagefind-modal-body>
	<pagefind-modal-footer>
		<pagefind-keyboard-hints></pagefind-keyboard-hints>
	</pagefind-modal-footer>
</pagefind-modal>

<style>
	search-toggle:not(:defined) {
		pointer-events: none;
		opacity: 0.3;
	}

	/* Eager layout rules so the header never shifts while the deferred stylesheet loads */
	pagefind-config {
		display: none;
	}

	pagefind-modal {
		display: contents;
	}

	pagefind-modal:not(:defined) {
		display: none;
	}
</style>
