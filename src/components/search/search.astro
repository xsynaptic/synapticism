---
import type { HTMLAttributes } from 'astro/types';

import { t } from '#lib/i18n/i18n-strings.ts';
import pagefindCssUrl from '#styles/pagefind-component.css?url';

type Props = HTMLAttributes<'div'>;

const props = Astro.props;

const bundlePath = `${import.meta.env.BASE_URL}pagefind/`;
---

<script>
	import type { PagefindModal } from '@pagefind/component-ui';

	import '#components/search/search-toggle.ts';

	// Clears the Pagefind registry on navigation so search-toggle's modal-trigger registrations don't pile up
	// Pagefind still exposes no deregisterUtility as of 1.5.2; see search-toggle.ts
	document.addEventListener('astro:before-swap', () => {
		const instance = document.querySelector<PagefindModal>('pagefind-modal')?.instance;

		if (!instance) return;

		instance.components = [];
		instance.componentsByType = {};
	});
</script>

<pagefind-config bundle-path={bundlePath} preload={false}></pagefind-config>

<search-toggle
	class:list={['flex cursor-pointer items-center justify-center rounded-full']}
	data-pagefind-css-url={pagefindCssUrl}
	{...props}
>
	<button
		aria-expanded="false"
		aria-haspopup="dialog"
		aria-label={t('site.search.toggle.label')}
		class="text-lg text-white"
		data-umami-event="search-open"
		title={t('site.search.toggle.title')}
	>
		<svg height="1em" viewBox="0 0 24 24" width="1em" xmlns="http://www.w3.org/2000/svg">
			<path d="M0 0h24v24H0z" fill="none"></path>
			<path
				d="m20 20l-4.05-4.05m0 0a7 7 0 1 0-9.9-9.9a7 7 0 0 0 9.9 9.9"
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"></path>
		</svg>
	</button>
</search-toggle>
<pagefind-modal reset-on-close={true}>
	<pagefind-modal-header>
		<pagefind-input placeholder={t('site.search.placeholder')}></pagefind-input>
	</pagefind-modal-header>
	<pagefind-modal-body>
		<pagefind-summary></pagefind-summary>
		<pagefind-results></pagefind-results>
	</pagefind-modal-body>
	<pagefind-modal-footer>
		<pagefind-keyboard-hints></pagefind-keyboard-hints>
	</pagefind-modal-footer>
</pagefind-modal>
