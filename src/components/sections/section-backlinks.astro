---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import LabeledSection from '#components/parts/labeled-section.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

// The list is a sample, not an inventory
const backlinksDisplayLimit = 10;

interface Props {
	backlinks: Array<CatalogItem> | undefined;
}

const { backlinks: backlinksAll } = Astro.props;

const backlinks = backlinksAll?.slice(0, backlinksDisplayLimit);
---

{
	backlinks && backlinks.length > 0 ? (
		<LabeledSection data-nosnippet data-pagefind-ignore title={t('section.backlinks')}>
			<ul class="flex flex-col gap-1 text-sm">
				{backlinks.map(({ title, url }) => (
					<li>
						<Anchor anchorColor="accent" class="anchor-underline" href={url}>
							{title}
						</Anchor>
					</li>
				))}
			</ul>
		</LabeledSection>
	) : undefined
}
