---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import SectionEntryList from '#components/sections/section-entry-list.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

// The list is a sample, not an inventory
const backlinksDisplayLimit = 10;

interface Props {
	backlinks: Array<CatalogItem> | undefined;
}

const { backlinks } = Astro.props;
---

<SectionEntryList
	entries={backlinks?.slice(0, backlinksDisplayLimit)}
	title={t('section.backlinks')}
/>
