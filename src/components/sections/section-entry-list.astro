---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import LabeledSection from '#components/parts/labeled-section.astro';

interface Props {
	entries: Array<CatalogItem> | undefined;
	title: string;
}

const { entries, title } = Astro.props;
---

{entries && entries.length > 0 ? (
	<LabeledSection data-nosnippet data-pagefind-ignore title={title}>
		<ul class="flex flex-col gap-1 text-sm">
			{entries.map((entry) => (
				<li>
					<Anchor anchorColor="accent" class="anchor-underline" href={entry.url}>
						{entry.title}
					</Anchor>
				</li>
			))}
		</ul>
	</LabeledSection>
) : undefined}
