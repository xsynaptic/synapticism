---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import LabeledSection from '#components/parts/labeled-section.astro';

interface Props {
	entries: Array<CatalogItem> | undefined;
	href?: string | undefined;
	title: string;
}

const { entries, href, title } = Astro.props;
---

{entries && entries.length > 0 ? (
	<LabeledSection data-nosnippet={true} data-pagefind-ignore={true} href={href} title={title}>
		<ul class="flex flex-col gap-1 text-sm">
			{entries.map((entry) => (
				<li>
					<Anchor accent={true} href={entry.url}>
						{entry.title}
					</Anchor>
				</li>
			))}
		</ul>
	</LabeledSection>
) : undefined}
