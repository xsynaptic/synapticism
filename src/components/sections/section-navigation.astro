---
import type { ContentNavigationItem } from '#components/types.ts';

import Anchor from '#components/parts/anchor.astro';
import LabeledSection from '#components/parts/labeled-section.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	baseUrl: string;
	labelPLural: string;
	labelSingular: string;
	newerItem: ContentNavigationItem | undefined;
	olderItem: ContentNavigationItem | undefined;
}

const { baseUrl, labelPLural, labelSingular, newerItem, olderItem } = Astro.props;
---

{
	newerItem || olderItem ? (
		<LabeledSection
			data-nosnippet
			data-pagefind-ignore
			title={formatStringTemplate(t('section.navigation.title'), { label: labelPLural })}
		>
			<nav class="flex items-baseline gap-4 text-sm">
				<span class="flex min-w-0 flex-1 items-baseline justify-start gap-1">
					{newerItem ? (
						<Fragment>
							<span aria-hidden="true" class="shrink-0 text-primary-600">
								&larr;
							</span>
							<Anchor
								anchorColor="accent"
								class="anchor-underline min-w-0 italic"
								href={newerItem.url}
							>
								<span class="sr-only">
									{formatStringTemplate(t('section.navigation.label.newer'), {
										label: labelSingular,
									})}
								</span>
								{newerItem.title}
							</Anchor>
						</Fragment>
					) : undefined}
				</span>
				<Anchor anchorColor="accent" class="shrink-0" href={baseUrl}>
					{formatStringTemplate(t('section.navigation.label.list'), { label: labelPLural })}
				</Anchor>
				<span class="flex min-w-0 flex-1 items-baseline justify-end gap-1">
					{olderItem ? (
						<Fragment>
							<Anchor
								anchorColor="accent"
								class="anchor-underline min-w-0 italic"
								href={olderItem.url}
							>
								<span class="sr-only">
									{formatStringTemplate(t('section.navigation.label.older'), {
										label: labelSingular,
									})}
								</span>
								{olderItem.title}
							</Anchor>
							<span aria-hidden="true" class="shrink-0 text-primary-600">
								&rarr;
							</span>
						</Fragment>
					) : undefined}
				</span>
			</nav>
		</LabeledSection>
	) : undefined
}
