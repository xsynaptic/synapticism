---
import type { NoteNavItem } from '#components/types.ts';

import LabeledSection from '#components/parts/labeled-section.astro';
import Link from '#components/parts/link.astro';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	newer: NoteNavItem | undefined;
	older: NoteNavItem | undefined;
}

const { newer, older } = Astro.props;

const notesUrl = getContentUrl('notes');
---

<LabeledSection data-nosnippet data-pagefind-ignore label="More Notes">
	<nav class="flex items-baseline gap-4 text-sm">
		<span class="flex min-w-0 flex-1 items-baseline justify-start gap-1.5">
			{
				newer ? (
					<Fragment>
						<span aria-hidden="true" class="shrink-0 text-primary-600">
							&larr;
						</span>
						<Link class="link-underline min-w-0" href={newer.url} linkColor="accent">
							<span class="sr-only">Newer note: </span>
							{newer.title}
						</Link>
					</Fragment>
				) : undefined
			}
		</span>
		<Link class="shrink-0" href={notesUrl} linkColor="accent">All Notes</Link>
		<span class="flex min-w-0 flex-1 items-baseline justify-end gap-1.5">
			{
				older ? (
					<Fragment>
						<Link class="link-underline min-w-0" href={older.url} linkColor="accent">
							<span class="sr-only">Older note: </span>
							{older.title}
						</Link>
						<span aria-hidden="true" class="shrink-0 text-primary-600">
							&rarr;
						</span>
					</Fragment>
				) : undefined
			}
		</span>
	</nav>
</LabeledSection>
