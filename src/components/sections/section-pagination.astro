---
import type { SectionPagination } from '#lib/utils/pagination-types.ts';

import Anchor from '#components/parts/anchor.astro';
import LabeledSection from '#components/parts/labeled-section.astro';

type Props = SectionPagination;

const { href, next, previous, title } = Astro.props;
---

{previous || next ? (
	<LabeledSection data-nosnippet={true} data-pagefind-ignore={true} href={href} title={title}>
		<nav class="grid gap-4 text-sm sm:grid-cols-2 sm:gap-8">
			{previous ? (
				<p>
					<span aria-hidden="true" class="text-primary-600">
						&larr;
					</span>
					&nbsp;
					<Anchor accent={true} class="italic" href={previous.url}>
						<span class="sr-only">{previous.label}</span>
						{previous.title}
					</Anchor>
				</p>
			) : undefined}
			{next ? (
				<p class="sm:col-start-2 sm:text-end">
					<Anchor accent={true} class="italic" href={next.url}>
						<span class="sr-only">{next.label}</span>
						{next.title}
					</Anchor>
					&nbsp;
					<span aria-hidden="true" class="text-primary-600">
						&rarr;
					</span>
				</p>
			) : undefined}
		</nav>
	</LabeledSection>
) : undefined}
