---
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getSitePath } from '#lib/utils/routing.ts';

interface Props {
	pageNumber: number;
	totalPages: number;
}

const { pageNumber, totalPages } = Astro.props;

let previousUrl: string | undefined;

if (pageNumber > 1) {
	previousUrl = pageNumber === 2 ? getSitePath() : getSitePath('page', String(pageNumber - 1));
}

const nextUrl = pageNumber < totalPages ? getSitePath('page', String(pageNumber + 1)) : undefined;
---

{totalPages > 1 ? (
	<nav aria-label={t('aria.streamPagination')} class="mt-10 flex justify-between font-mono text-sm">
		{previousUrl ? (
			<Anchor anchorColor="accent" href={previousUrl}>
				<span aria-hidden="true">&larr;</span> {t('index.newer')}
			</Anchor>
		) : (
			<span />
		)}
		{nextUrl ? (
			<Anchor anchorColor="accent" href={nextUrl}>
				{t('index.older')} <span aria-hidden="true">&rarr;</span>
			</Anchor>
		) : (
			<span />
		)}
	</nav>
) : undefined}
