---
import type { ComponentProps } from 'astro/types';

import { openGraphImageHeight, openGraphImageWidth } from '@synapticism/shared/constants';

import ContentCard from '#components/content/content-card.astro';
import ContentContinueReading from '#components/content/content-continue-reading.astro';
import ContentDate from '#components/content/content-date.astro';
import ContentExcerpt from '#components/content/content-excerpt.astro';
import ContentHeader from '#components/content/content-header.astro';
import ContentHero from '#components/content/content-hero.astro';
import ContentImage from '#components/content/content-image.astro';
import ContentSection from '#components/content/content-section.astro';
import ContentSubtitle from '#components/content/content-subtitle.astro';
import EntrySubtitle from '#components/content/entry-subtitle.astro';
import EntryTitle from '#components/content/entry-title.astro';
import ImageCarousel from '#components/image/image-carousel.astro';
import MainSite from '#components/main/main-site.astro';
import Link from '#components/mdx/link.astro';
import Anchor from '#components/parts/anchor.astro';
import ChipRow from '#components/parts/chip-row.astro';
import Chip from '#components/parts/chip.astro';
import DateDisplay from '#components/parts/date-display.astro';
import DividedItem from '#components/parts/divided-item.astro';
import LabeledRow from '#components/parts/labeled-row.astro';
import LabeledSection from '#components/parts/labeled-section.astro';
import ListRow from '#components/parts/list-row.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import ProseBody from '#components/parts/prose-body.astro';
import ProseDescription from '#components/parts/prose-description.astro';
import SectionEntryList from '#components/sections/section-entry-list.astro';
import SectionPagination from '#components/sections/section-pagination.astro';
import { projectImageAspectRatio } from '#constants.ts';
import {
	createSamplePage,
	getSampleOpenGraphCards,
	openGraphSampleKeys,
	sampleCardDescription,
	sampleCardTagItems,
	sampleCarouselImages,
	sampleCatalogItems,
	sampleChipItems,
	sampleDate,
	sampleDateTime,
	sampleDateUpdated,
	sampleImageFeatured,
	sampleImageId,
	sampleImageMissingNote,
	samplePaginationNext,
	samplePaginationPrevious,
	sampleRowItems,
	sampleSubtitlePost,
	sampleSubtitleProjectOneOff,
	sampleSubtitleProjectOngoing,
} from '#dev/inventory/inventory-fixtures.ts';
import ProseSample from '#dev/inventory/inventory-prose-sample.mdx';
import Section from '#dev/inventory/inventory-section.astro';
import Specimen from '#dev/inventory/inventory-specimen.astro';
import { getSectionId } from '#dev/inventory/inventory-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { getPagePagination } from '#lib/utils/pagination.ts';
import '#dev/inventory/inventory.css';

// Semantic ramps only; pale-sky, blue-chill and cumin are the primitives they alias
const colorRamps = [
	{ name: 'primary', source: 'pale-sky' },
	{ name: 'accent', source: 'blue-chill' },
	{ name: 'highlight', source: 'cumin' },
];

const colorSteps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];

const technocratColors = [
	{ hex: '#1fc2c2', name: 'java', role: 'links, social icons, primary buttons' },
	{ hex: '#34efef', name: 'java active', role: 'link active' },
	{ hex: '#4debeb', name: 'java focus', role: 'link focus' },
	{ hex: '#1e9ab0', name: 'eastern-blue', role: 'menu bar, title hover' },
	{ hex: '#ef863f', name: 'jaffa', role: 'entry titles, hover, highlight' },
	{ hex: '#25272c', name: 'shark', role: 'page, sidebar, code blocks' },
	{ hex: '#444954', name: 'mako', role: 'text, header, footer' },
	{ hex: '#727b89', name: 'raven', role: 'muted text, tags, sidebar links' },
	{ hex: '#bdc9ce', name: 'loblolly', role: 'meta, date box' },
	{ hex: '#fcfcfc', name: 'grey 252', role: 'body background' },
	{ hex: '#97cd2d', name: 'atlantis', role: 'success' },
	{ hex: '#b81104', name: 'milano-red', role: 'error' },
	{ hex: '#fffacd', name: 'lemon-chiffon', role: 'highlight background' },
];

const typeSteps = ['xs', 'sm', 'base', 'lg', 'xl', '2xl', '3xl', '4xl'];

const fontFamilies = [
	{ name: 'font-sans', note: 'Red Hat Text, 300 to 700, normal and italic' },
	{ name: 'font-display', note: 'Aleo, 300 to 700, normal and italic' },
	{ name: 'font-mono', note: 'Red Hat Mono, 300 to 700' },
];

const iconNames = [
	'chevron-down',
	'chevron-up',
	'chevron-left',
	'chevron-right',
	'github',
	'rss',
	'search',
];

const sections = ['Foundations', 'Prose', 'Anchors', 'Parts', 'Content', 'Open Graph'];

const anchorUnderlineModes = ['always', 'hover', 'none'] satisfies Array<
	NonNullable<ComponentProps<typeof Anchor>['underline']>
>;

const chipEdgeColors = ['primary', 'accent', 'highlight'] satisfies Array<
	NonNullable<ComponentProps<typeof Chip>['edgeColor']>
>;

const datePresets = Object.values(DatePresetEnum);

const samplePageFirst = createSamplePage(1, 1);
const samplePageMiddle = createSamplePage(3, 12);

const sampleOpenGraphCards = await getSampleOpenGraphCards();
---

<MainSite hasReadingBar={true} meta={{ noIndex: true, title: 'Inventory' }} template="full">
	<div class="pb-16">
		<div class="content-column pt-8">
			<h1 class="font-mono text-base font-medium text-primary-800">Inventory</h1>
			<nav class="mt-4 flex flex-wrap gap-x-5 font-mono text-sm">
				{sections.map((section) => (
					<Anchor accent={true} href={`#${getSectionId(section)}`} underline="hover">
						{section}
					</Anchor>
				))}
			</nav>
		</div>
		<Section title="Foundations">
			<Specimen name="Color ramps" source="styles/main/parts/theme.css">
				<div class="flex flex-col gap-5">
					{colorRamps.map((ramp) => (
						<div>
							<div class="font-mono text-xs text-primary-600">
								--color-{ramp.name}-*{' '}
								<span class="font-mono text-xs text-primary-500">({ramp.source})</span>
							</div>
							<div class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(4rem,1fr))] gap-1">
								{colorSteps.map((step) => (
									<div>
										<div
											class="h-12 rounded-sm border border-primary-300"
											style={`background-color: var(--color-${ramp.name}-${String(step)})`}
										/>
										<div class="mt-1 font-mono text-[0.6875rem] text-primary-500">{step}</div>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen
				name="Technocrat palette"
				note="Reference only; no token reads them."
				source="wp-technocrat/src/scss/config/_colours.scss"
			>
				<div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] gap-3">
					{technocratColors.map((color) => (
						<div>
							<div
								class="h-16 rounded-sm border border-primary-300"
								style={`background-color: ${color.hex}`}
							/>
							<div class="mt-1 font-mono text-xs text-primary-700">{color.name}</div>
							<div class="font-mono text-[0.6875rem] text-primary-500">{color.hex}</div>
							<div class="text-xs leading-snug text-primary-600">{color.role}</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen name="Type scale" source="styles/main/parts/theme.css">
				<div class="flex flex-col gap-4">
					{typeSteps.map((step) => (
						<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0">
							<div class="font-mono text-xs text-primary-500">text-{step}</div>
							<div style={`font-size: var(--text-${step})`}>
								The quick brown fox jumps over the lazy dog
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen name="Font families" source="styles/main/parts/theme.css">
				<div class="flex flex-col gap-4">
					{fontFamilies.map((family) => (
						<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0">
							<div class="font-mono text-xs text-primary-500">
								{family.name}, {family.note}
							</div>
							<div style={`font-family: var(--${family.name}); font-size: var(--text-xl)`}>
								Synapticism 0123456789 <em>italic</em> <strong>bold</strong>
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen name="Icons" source="components/main/main-sprites.astro">
				<div class="flex flex-wrap gap-6 text-2xl text-primary-700">
					{iconNames.map((iconName) => (
						<div class="flex flex-col items-center gap-2">
							<svg aria-hidden="true" height="1em" width="1em">
								<use href={`#icon:${iconName}`} />
							</svg>
							<span class="font-mono text-xs text-primary-500">{iconName}</span>
						</div>
					))}
				</div>
			</Specimen>
		</Section>
		<Section title="Prose">
			<Specimen bleed={true} name="prose-body" source="components/parts/prose-body.astro">
				<ProseBody data-reading-frame>
					<ProseSample />
				</ProseBody>
			</Specimen>
			<Specimen name="prose-description" source="components/parts/prose-description.astro">
				<ProseDescription>
					<p>
						A Description renders inline markdown only: <em>emphasis</em>, <strong>strong</strong>,
						and nothing else survives the sanitizer.
					</p>
				</ProseDescription>
			</Specimen>
			<Specimen
				bleed={true}
				name="mdx/link"
				note="A fixture id has no target, so this is the unlinked fallback."
				source="components/mdx/link.astro"
			>
				<ProseBody>
					<p>
						An internal <Link id="sample-post">reference to another Entry</Link>.
					</p>
				</ProseBody>
			</Specimen>
		</Section>
		<Section title="Anchors">
			<Specimen name="underline modes" source="components/parts/anchor.astro">
				<div class="flex flex-col gap-4">
					{anchorUnderlineModes.map((underline) => (
						<p class="grid gap-1 sm:grid-cols-[10rem_1fr]">
							<span class="font-mono text-xs text-primary-500">{underline}</span>
							<span>
								A sentence with{' '}
								<Anchor href="#anchors" underline={underline}>
									a link in it
								</Anchor>
								, then{' '}
								<Anchor accent={true} href="#anchors" underline={underline}>
									an accent link
								</Anchor>
								.
							</span>
						</p>
					))}
					<p class="grid gap-1 sm:grid-cols-[10rem_1fr]">
						<span class="font-mono text-xs text-primary-500">end slot</span>
						<span>
							An icon link:{' '}
							<Anchor href="#anchors">
								Source Code
								<svg aria-hidden="true" height="1em" slot="end" width="1em">
									<use href="#icon:github"></use>
								</svg>
							</Anchor>
						</span>
					</p>
				</div>
			</Specimen>
			<Specimen name="type sizes">
				<div class="flex flex-col gap-4">
					<EntryTitle as="h2" href="#anchors">
						A display title, no line
					</EntryTitle>
					<p class="text-lg">
						<Anchor href="#anchors">Body text at prose size, spanning enough words to wrap</Anchor>
					</p>
					<p class="text-xs text-primary-500">
						2012&ndash;present &middot;{' '}
						<Anchor href="#anchors" underline="hover">
							Homepage
						</Anchor>
					</p>
				</div>
			</Specimen>
			<Specimen name="hosts and scope">
				<div class="flex flex-col gap-4">
					<ProseBody class="px-0!" frame="column">
						<p>
							A <a href="#anchors">bare Markdown link</a> inside prose.
						</p>
					</ProseBody>
					<p class="anchor-ink-title">
						anchor-ink-title:{' '}
						<Anchor href="#anchors" underline="hover">
							{t('content.continueReading')}
						</Anchor>
					</p>
					<div class="anchor-ink-on-dark flex flex-wrap items-baseline gap-x-6 gap-y-3 rounded-sm bg-primary-800 px-5 py-4 text-sm text-primary-300">
						anchor-ink-on-dark:
						<Anchor href="#anchors" underline="hover">
							Recent Post title
						</Anchor>
						<Anchor href="#anchors" underline="none">
							Site title
						</Anchor>
					</div>
				</div>
			</Specimen>
		</Section>
		<Section title="Parts">
			<Specimen name="date-display" source="components/parts/date-display.astro">
				<div class="flex flex-col gap-4">
					{datePresets.map((datePreset) => (
						<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0">
							<div class="font-mono text-xs text-primary-500">{datePreset}</div>
							<div class="mt-1 flex flex-wrap gap-x-6 gap-y-1">
								<DateDisplay date={sampleDate} datePreset={datePreset} />
								<DateDisplay date={sampleDateTime} datePreset={datePreset} />
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen name="chip" source="components/parts/chip.astro">
				<div class="flex flex-col gap-3">
					{chipEdgeColors.map((edgeColor) => (
						<div class="flex flex-wrap items-center gap-x-2 gap-y-3">
							<span class="w-20 font-mono text-xs text-primary-500">{edgeColor}</span>
							<Chip edgeColor={edgeColor} href="#chip">
								Creative Coding
							</Chip>
							<Chip count={5} edgeColor={edgeColor} href="#chip">
								Creative Coding
							</Chip>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen name="chip-row" source="components/parts/chip-row.astro">
				<ChipRow items={sampleChipItems} />
			</Specimen>
			<Specimen name="divided-item / list-row" source="components/parts/">
				<div class="flex flex-col gap-3 text-lg">
					<ListRow>
						<DividedItem as="li">Default</DividedItem>
						<DividedItem as="li">divider</DividedItem>
						<DividedItem as="li">weight</DividedItem>
					</ListRow>
					<ListRow>
						<DividedItem as="li" class="divided-thin">
							Thin
						</DividedItem>
						<DividedItem as="li" class="divided-thin">
							divider
						</DividedItem>
						<DividedItem as="li" class="divided-thin">
							weight
						</DividedItem>
					</ListRow>
				</div>
			</Specimen>
			<Specimen bleed={true} name="labeled-section" source="components/parts/labeled-section.astro">
				<LabeledSection title="Heading level two">
					<p>Section body</p>
				</LabeledSection>
				<LabeledSection as="h3" title="Heading level three">
					<p>Section body</p>
				</LabeledSection>
			</Specimen>
			<Specimen bleed={true} name="labeled-row" source="components/parts/labeled-row.astro">
				<LabeledRow items={sampleRowItems} title="Projects" />
			</Specimen>
			<Specimen name="pagination-select" source="components/parts/pagination-select.astro">
				<div class="flex flex-col gap-4">
					<PaginationSelect pagination={getPagePagination(samplePageFirst)} />
					<PaginationSelect pagination={getPagePagination(samplePageMiddle)} />
				</div>
			</Specimen>
		</Section>
		<Section title="Content">
			<Specimen bleed={true} name="content-header" source="components/content/content-header.astro">
				<ContentHeader
					title="An Entry title long enough to wrap and show the balance"
					titleUrl="#header"
				>
					<EntrySubtitle entry={sampleSubtitlePost} minutesRead={8} slot="header-subtitle" />
				</ContentHeader>
				<ContentHeader title="The same header with no subtitle and no self-link" />
			</Specimen>
			<Specimen name="entry-title" source="components/content/entry-title.astro">
				<div class="flex flex-col gap-6">
					<div>
						<EntryTitle as="h1" href="#entry-title">
							A page title with descenders: gjpqy
						</EntryTitle>
						<ContentSubtitle html="September 2, 2026" />
					</div>
					<div>
						<EntryTitle as="h2" href="#entry-title">
							A list title with descenders: gjpqy
						</EntryTitle>
						<ContentSubtitle html="September 2, 2026" />
					</div>
				</div>
			</Specimen>
			<Specimen name="content-date" source="components/content/content-date.astro">
				<div class="flex flex-col gap-3 text-xs text-primary-500">
					<div class="flex flex-wrap items-center gap-1">
						<ContentDate dateCreated={new Date(sampleDate)} />
					</div>
					<div class="flex flex-wrap items-center gap-1">
						<ContentDate
							dateCreated={new Date(sampleDate)}
							dateUpdated={new Date(sampleDateUpdated)}
						/>
					</div>
				</div>
			</Specimen>
			<Specimen name="entry-subtitle" source="components/content/entry-subtitle.astro">
				<div class="flex flex-col gap-3 text-xs text-primary-500">
					<div class="flex flex-wrap items-center gap-1">
						<EntrySubtitle entry={sampleSubtitlePost} minutesRead={8} />
					</div>
					<div class="flex flex-wrap items-center gap-1">
						<EntrySubtitle entry={sampleSubtitleProjectOngoing} />
					</div>
					<div class="flex flex-wrap items-center gap-1">
						<EntrySubtitle entry={sampleSubtitleProjectOneOff} />
					</div>
				</div>
			</Specimen>
			<Specimen bleed={true} name="content-hero" source="components/content/content-hero.astro">
				{sampleImageFeatured ? (
					<ContentHero
						{...sampleImageFeatured}
						fallbackAlt="Fallback alt text"
						isPriority={false}
						template="full"
					/>
				) : (
					<p class="font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
			<Specimen bleed={true} name="content-image" source="components/content/content-image.astro">
				{sampleImageId ? (
					<ProseBody>
						<ContentImage src={sampleImageId}>A caption beneath the frame</ContentImage>
					</ProseBody>
				) : (
					<p class="font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
			<Specimen
				bleed={true}
				name="content-section"
				source="components/content/content-section.astro"
			>
				<ContentSection>
					<Fragment slot="section-description">
						<p>A description, rendered through prose-description.</p>
					</Fragment>
					<p>Section children</p>
				</ContentSection>
			</Specimen>
			<Specimen
				bleed={true}
				name="content-excerpt"
				source="components/content/content-excerpt.astro"
			>
				<ContentExcerpt entryUrl="#excerpt">
					<Fragment slot="excerpt-title">An excerpt title, linked to its Entry</Fragment>
					<EntrySubtitle entry={sampleSubtitlePost} slot="excerpt-subtitle" />
					<ProseSample />
				</ContentExcerpt>
			</Specimen>
			<Specimen name="content-card" source="components/content/content-card.astro">
				<ContentCard
					description={sampleCardDescription}
					tagItems={sampleCardTagItems}
					title="A card title, linked to its Entry"
					url="/inventory/#content-card"
				>
					<ImageCarousel
						aspectRatio={projectImageAspectRatio}
						images={sampleCarouselImages}
						isPriority={false}
						slot="card-media"
					/>
					<EntrySubtitle entry={sampleSubtitleProjectOngoing} slot="card-subtitle" />
					<ContentContinueReading href="/inventory/#content-card" slot="card-links" />
				</ContentCard>
				{sampleImageId ? undefined : (
					<p class="mt-4 font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
			<Specimen name="image-carousel" source="components/image/image-carousel.astro">
				<div class="flex flex-col gap-6">
					<ImageCarousel
						aspectRatio={projectImageAspectRatio}
						images={sampleCarouselImages.slice(0, 1)}
						isPriority={false}
					/>
					<ImageCarousel
						aspectRatio={projectImageAspectRatio}
						images={sampleCarouselImages}
						isPriority={false}
					/>
				</div>
				{sampleImageId ? undefined : (
					<p class="mt-4 font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
			<Specimen
				bleed={true}
				name="section-entry-list"
				source="components/sections/section-entry-list.astro"
			>
				<SectionEntryList entries={sampleCatalogItems} title={t('section.relatedWriting')} />
			</Specimen>
			<Specimen
				bleed={true}
				name="section-pagination"
				source="components/sections/section-pagination.astro"
			>
				<SectionPagination
					collection="posts"
					nextEntry={samplePaginationNext}
					previousEntry={samplePaginationPrevious}
				/>
				<SectionPagination
					collection="projects"
					nextEntry={samplePaginationNext}
					previousEntry={undefined}
				/>
			</Specimen>
		</Section>
		<Section note="packages/scripts/src/og-image/element.tsx" title="Open Graph">
			<div class="mx-auto mt-6 grid max-w-7xl gap-x-6 gap-y-8 px-4 md:grid-cols-2 md:px-8">
				{openGraphSampleKeys.map((key) => {
					const card = sampleOpenGraphCards.find((item) => item.key === key);

					return (
						<figure>
							{card ? (
								<a href={`/inventory/og/${key}.jpg`}>
									<img
										alt={card.title}
										class="h-auto w-full rounded-sm border border-primary-300"
										height={openGraphImageHeight}
										loading="lazy"
										src={`/inventory/og/${key}.jpg`}
										width={openGraphImageWidth}
									/>
								</a>
							) : (
								<div class="flex aspect-[1200/630] items-center justify-center rounded-sm border border-dashed border-primary-300 font-mono text-xs text-primary-500">
									no sample
								</div>
							)}
							<figcaption class="mt-2 font-mono text-xs text-primary-500">{key}</figcaption>
						</figure>
					);
				})}
			</div>
		</Section>
	</div>
</MainSite>
