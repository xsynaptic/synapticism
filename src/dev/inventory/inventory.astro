---
import type { ComponentProps } from 'astro/types';

import { openGraphImageHeight, openGraphImageWidth } from '@synapticism/shared/constants';

import ContentDate from '#components/content/content-date.astro';
import ContentExcerpt from '#components/content/content-excerpt.astro';
import ContentHeader from '#components/content/content-header.astro';
import ContentHero from '#components/content/content-hero.astro';
import ContentImage from '#components/content/content-image.astro';
import ContentNoteLinks from '#components/content/content-note-links.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import Link from '#components/mdx/link.astro';
import Anchor from '#components/parts/anchor.astro';
import DateDisplay from '#components/parts/date-display.astro';
import DividedItem from '#components/parts/divided-item.astro';
import LabeledRow from '#components/parts/labeled-row.astro';
import LabeledSection from '#components/parts/labeled-section.astro';
import ListRow from '#components/parts/list-row.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import PreviewImage from '#components/parts/preview-image.astro';
import ProseBody from '#components/parts/prose-body.astro';
import ProseDescription from '#components/parts/prose-description.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionPagination from '#components/sections/section-pagination.astro';
import SectionRelatedContent from '#components/sections/section-related-content.astro';
import {
	createSamplePage,
	getSampleOpenGraphCards,
	sampleCatalogItems,
	sampleDate,
	sampleDateTime,
	sampleDateUpdated,
	sampleImageFeatured,
	sampleImageId,
	sampleImageMissingNote,
	sampleLinks,
	samplePaginationNewer,
	samplePaginationOlder,
	sampleRowItems,
	sampleSource,
} from '#dev/inventory/inventory-fixtures.ts';
import ProseSample from '#dev/inventory/inventory-prose-sample.mdx';
import Section from '#dev/inventory/inventory-section.astro';
import Specimen from '#dev/inventory/inventory-specimen.astro';
import { getSectionId } from '#dev/inventory/inventory-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';

import './inventory.css';

// Semantic ramps only; blue-chill and cumin are the primitives accent and highlight alias
const colorRamps = [
	{ name: 'primary', source: 'zinc' },
	{ name: 'accent', source: 'blue-chill' },
	{ name: 'highlight', source: 'cumin' },
];

const colorSteps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];

const typeSteps = ['xs', 'sm', 'base', 'lg', 'xl', '2xl', '3xl', '4xl'];

const fontFamilies = [
	{ name: 'font-sans', note: 'Aleo, 300 to 700, normal and italic' },
	{ name: 'font-mono', note: 'Geist Mono, 300 to 700' },
];

const sections = ['Foundations', 'Prose', 'Parts', 'Content', 'Open Graph'];

interface OpenGraphSpecimen {
	key: string;
	missing?: string;
	name: string;
	note: string;
}

// Only the cards needing a Featured Image can go missing, so only those carry a fallback
const openGraphSpecimens: Array<OpenGraphSpecimen> = [
	{
		key: 'image-split',
		missing: 'No Entry resolves a Featured Image, so there is no panel to fill.',
		name: 'og-image (split)',
		note: 'The image takes the right panel behind a teal seam; the text column narrows to what is left.',
	},
	{
		key: 'image-long',
		missing: 'No Entry resolves a Featured Image, so there is no panel to fill.',
		name: 'og-image (split, long title)',
		note: 'Thresholds ride the text measure, so this half-width column steps the title down a size sooner than the full-bleed cards below.',
	},
	{
		key: 'title-only',
		missing: 'Every Entry resolves a Featured Image, so nothing falls back to full-bleed.',
		name: 'og-image (title only)',
		note: 'No Featured Image: the text column takes the full width and the padding opens up.',
	},
	{
		key: 'label-none',
		name: 'og-image (no label)',
		note: 'Index cards and Pages carry no label, so the rule stands alone above the title.',
	},
	{
		key: 'title-short',
		name: 'og-image (72px title)',
		note: 'The top of the four-step size ramp. Written rather than found: every real title lands on this step.',
	},
	{
		key: 'title-medium',
		name: 'og-image (60px title)',
		note: 'Past 32 characters.',
	},
	{
		key: 'title-clamped',
		name: 'og-image (40px title, clamped)',
		note: 'Past 96 characters, the bottom of the ramp, overrunning the four-line clamp.',
	},
];

type AnchorColor = NonNullable<ComponentProps<typeof Anchor>['anchorColor']>;

// Split by the ground each colour is designed for; removing one from the union breaks the build
const anchorColorsOnLight = [
	'primary',
	'primary-bright',
	'title',
	'accent',
] satisfies Array<AnchorColor>;

const anchorColorOnDark = 'on-dark' satisfies AnchorColor;
const anchorColorOnAccent = 'on-accent' satisfies AnchorColor;

const datePresets = Object.values(DatePresetEnum);

const samplePageFirst = createSamplePage(1, 1);
const samplePageMiddle = createSamplePage(3, 12);

const sampleOpenGraphCards = await getSampleOpenGraphCards();
---

<MainSite hasReadingBar={true} meta={{ noIndex: true, title: 'Inventory' }}>
	<div class="pb-16">
		<div class="content-column pt-8">
			<h1 class="font-mono text-base font-medium text-primary-800">Inventory</h1>
			<p class="mt-2 max-w-(--prose-measure) text-sm leading-relaxed text-primary-600">
				Every common component, rendered from its real source with fixture props. Dev only.
			</p>
			<nav class="mt-4 flex flex-wrap gap-x-5 font-mono text-sm">
				{sections.map((section) => (
					<Anchor anchorColor="accent" href={`#${getSectionId(section)}`}>
						{section}
					</Anchor>
				))}
			</nav>
		</div>
		<Section title="Foundations">
			<Specimen name="Color ramps" source="styles/main/parts/theme.css">
				<div class="flex flex-col gap-5">
					{colorRamps.map((ramp) => (
						<div>
							<div class="font-mono text-xs text-primary-600">
								--color-{ramp.name}-*{' '}
								<span class="font-mono text-xs text-primary-500">({ramp.source})</span>
							</div>
							<div class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(4rem,1fr))] gap-1">
								{colorSteps.map((step) => (
									<div>
										<div
											class="h-12 rounded-sm border border-primary-300"
											style={`background-color: var(--color-${ramp.name}-${String(step)})`}
										/>
										<div class="mt-1 font-mono text-[0.6875rem] text-primary-500">{step}</div>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen
				name="Type scale"
				note="Prose headings size in <code>em</code> against the body, so they sit in Prose rather than here."
				source="styles/main/parts/theme.css"
			>
				<div class="flex flex-col gap-4">
					{typeSteps.map((step) => (
						<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0">
							<div class="font-mono text-xs text-primary-500">text-{step}</div>
							<div style={`font-size: var(--text-${step})`}>
								The quick brown fox jumps over the lazy dog
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen name="Font families" source="styles/main/parts/theme.css">
				<div class="flex flex-col gap-4">
					{fontFamilies.map((family) => (
						<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0">
							<div class="font-mono text-xs text-primary-500">
								{family.name}, {family.note}
							</div>
							<div style={`font-family: var(--${family.name}); font-size: var(--text-xl)`}>
								Synapticism 0123456789 <em>italic</em> <strong>bold</strong>
							</div>
						</div>
					))}
				</div>
			</Specimen>
		</Section>
		<Section title="Prose">
			<Specimen
				bleed={true}
				name="prose-body"
				note="The <code>.prose-x</code> surface at full size, from an MDX fixture through the real satteri pipeline. Carries <code>data-reading-frame</code>, so the reading bar tracks it."
				source="components/parts/prose-body.astro"
			>
				<ProseBody data-reading-frame>
					<ProseSample />
				</ProseBody>
			</Specimen>
			<Specimen
				name="prose-description"
				note="The same typography one step down, for Descriptions and excerpt summaries."
				source="components/parts/prose-description.astro"
			>
				<ProseDescription>
					<p>
						A Description renders inline markdown only: <em>emphasis</em>, <strong>strong</strong>,
						and nothing else survives the sanitizer.
					</p>
				</ProseDescription>
			</Specimen>
			<Specimen
				bleed={true}
				name="mdx/link"
				note="Resolves an Entry id against the Catalog. A fixture id has no target, so this is the fallback: unlinked text rather than a throw."
				source="components/mdx/link.astro"
			>
				<ProseBody>
					<p>
						An internal <Link id="sample-post">reference to another Entry</Link>.
					</p>
				</ProseBody>
			</Specimen>
		</Section>
		<Section title="Parts">
			<Specimen
				name="anchor"
				note="Every <code>anchorColor</code> on the ground it was designed for; each has a <code>focus-visible</code> twin. <code>anchor-underline</code> adds the prose link treatment."
				source="components/parts/anchor.astro"
			>
				<div class="flex flex-col gap-4">
					<div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
						{anchorColorsOnLight.map((anchorColor) => (
							<Anchor anchorColor={anchorColor} href="#anchor">
								{anchorColor}
							</Anchor>
						))}
						<Anchor anchorColor="accent" class="anchor-underline" href="#anchor">
							accent + anchor-underline
						</Anchor>
					</div>
					<div class="rounded-sm bg-primary-800 px-5 py-4">
						<Anchor anchorColor={anchorColorOnDark} href="#anchor">
							{anchorColorOnDark}
						</Anchor>
					</div>
					<div class="rounded-sm bg-accent-500 px-5 py-4">
						<Anchor anchorColor={anchorColorOnAccent} href="#anchor">
							{anchorColorOnAccent}
						</Anchor>
					</div>
				</div>
			</Specimen>
			<Specimen
				name="date-display"
				note="Presets read from <code>DatePresetEnum</code>. A date authored with a time shows the time; a bare date does not."
				source="components/parts/date-display.astro"
			>
				<div class="flex flex-col gap-4">
					{datePresets.map((datePreset) => (
						<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0">
							<div class="font-mono text-xs text-primary-500">{datePreset}</div>
							<div class="mt-1 flex flex-wrap gap-x-6 gap-y-1">
								<DateDisplay date={sampleDate} datePreset={datePreset} />
								<DateDisplay date={sampleDateTime} datePreset={datePreset} />
							</div>
						</div>
					))}
				</div>
			</Specimen>
			<Specimen
				name="divided-item / list-row"
				note="<code>list-row</code> lays items out inline and wrapping; <code>divided-item</code> puts a slash between them and drops it on the last. Enlarged so <code>divided-thin</code> reads at all."
				source="components/parts/"
			>
				<div class="flex flex-col gap-3 text-lg">
					<ListRow>
						<DividedItem as="li">Default</DividedItem>
						<DividedItem as="li">divider</DividedItem>
						<DividedItem as="li">weight</DividedItem>
					</ListRow>
					<ListRow>
						<DividedItem as="li" class="divided-thin">
							Thin
						</DividedItem>
						<DividedItem as="li" class="divided-thin">
							divider
						</DividedItem>
						<DividedItem as="li" class="divided-thin">
							weight
						</DividedItem>
					</ListRow>
				</div>
			</Specimen>
			<Specimen
				bleed={true}
				name="labeled-section"
				note="The rule-and-label header under every Entry. Heading level is a prop, defaulting to <code>h2</code>."
				source="components/parts/labeled-section.astro"
			>
				<LabeledSection title="Heading level two">
					<p>Section body</p>
				</LabeledSection>
				<LabeledSection as="h3" title="Heading level three">
					<p>Section body</p>
				</LabeledSection>
			</Specimen>
			<Specimen
				bleed={true}
				name="labeled-row"
				note="A labeled section wrapping a divided row of links. <code>content-section-tags</code> and <code>content-section-projects</code> are lookups producing this same shape."
				source="components/parts/labeled-row.astro"
			>
				<LabeledRow items={sampleRowItems} title="Tags" />
			</Specimen>
			<Specimen
				name="pagination-counter"
				note="Hides itself on the first page: page 1 of 1, then page 3 of 12."
				source="components/parts/pagination-counter.astro"
			>
				<div class="flex flex-col gap-4">
					<PaginationCounter page={samplePageFirst} />
					<PaginationCounter page={samplePageMiddle} />
				</div>
			</Specimen>
			<Specimen
				name="pagination-select"
				note="Hides itself when there is one page. With JavaScript the counter swaps for a select."
				source="components/parts/pagination-select.astro"
			>
				<div class="flex flex-col gap-4">
					<PaginationSelect page={samplePageFirst} />
					<PaginationSelect page={samplePageMiddle} />
				</div>
			</Specimen>
			<Specimen
				name="preview-image"
				note="The square image beside an Entry in a listing: 4rem, 5rem from <code>md</code> up."
				source="components/parts/preview-image.astro"
			>
				{sampleImageId ? (
					<PreviewImage
						imgAlt="Preview image alt text"
						showMicroformats={true}
						src={sampleImageId}
					/>
				) : (
					<p class="font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
		</Section>
		<Section title="Content">
			<Specimen
				bleed={true}
				name="content-header"
				note="The <code>h1</code> of an Entry page. The title links to itself; the subtitle slot takes divided items."
				source="components/content/content-header.astro"
			>
				<ContentHeader
					title="An Entry title long enough to wrap and show the balance"
					titleUrl="#header"
				>
					<Fragment slot="header-subtitle">
						<DividedItem>
							<ContentDate
								date={sampleDate}
								datePreset={DatePresetEnum.Long}
								showMicroformats={true}
							/>
						</DividedItem>
						<DividedItem>
							<ContentDate
								date={sampleDateUpdated}
								datePreset={DatePresetEnum.Long}
								showMicroformats={true}
								showUpdated={true}
							/>
						</DividedItem>
						<DividedItem>8 minute read</DividedItem>
					</Fragment>
				</ContentHeader>
				<ContentHeader title="The same header with no subtitle and no self-link" />
			</Specimen>
			<Specimen
				name="content-date"
				note="<code>date-display</code> plus the microformat class and the “Updated” prefix. Renders nothing when the date is undefined."
				source="components/content/content-date.astro"
			>
				<div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
					<ContentDate date={sampleDate} datePreset={DatePresetEnum.Long} />
					<ContentDate
						date={sampleDateUpdated}
						datePreset={DatePresetEnum.Long}
						showUpdated={true}
					/>
					<span class="font-mono text-xs text-primary-500">
						undefined date: <ContentDate date={undefined} datePreset={DatePresetEnum.Long} />
						(nothing)
					</span>
				</div>
			</Specimen>
			<Specimen
				bleed={true}
				name="content-hero"
				note="A Featured Image at the top of an Entry, over its LQIP placeholder. Against <code>content-image</code>: an object rather than a path, <code>priority</code>, no caption, small radius, no border."
				source="components/content/content-hero.astro"
			>
				{sampleImageFeatured ? (
					<ContentHero {...sampleImageFeatured} fallbackAlt="Fallback alt text" />
				) : (
					<p class="font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
			<Specimen
				bleed={true}
				name="content-image"
				note="The in-body figure, breaking out past the reading measure. Against <code>content-hero</code>: lazy, a caption doubling as alt text, larger radius on a bordered frame."
				source="components/content/content-image.astro"
			>
				{sampleImageId ? (
					<ProseBody>
						<ContentImage src={sampleImageId}>A caption beneath the frame</ContentImage>
					</ProseBody>
				) : (
					<p class="font-mono text-xs text-primary-500">{sampleImageMissingNote}</p>
				)}
			</Specimen>
			<Specimen
				bleed={true}
				name="content-section"
				note="Every part of the header is an optional slot; <code>titleLarge</code>, <code>marginSmall</code> and <code>fillViewport</code> switch the treatment."
				source="components/content/content-section.astro"
			>
				<ContentSection>
					<Fragment slot="section-title">Default title</Fragment>
					<Fragment slot="section-subtitle">A subtitle beneath it</Fragment>
					<Fragment slot="section-description">
						<p>A description, rendered through prose-description.</p>
					</Fragment>
					<p>Section children</p>
				</ContentSection>
				<ContentSection marginSmall={true} titleLarge={true}>
					<Fragment slot="section-title">titleLarge with marginSmall</Fragment>
					<p>Section children</p>
				</ContentSection>
				<ContentSection fillViewport={true}>
					<Fragment slot="section-title">fillViewport</Fragment>
					<p>Reaches the viewport edge below the sm breakpoint</p>
				</ContentSection>
			</Specimen>
			<Specimen
				bleed={true}
				name="content-excerpt"
				note="A Note in the Stream, cut at the fold the author placed with <code>More</code>."
				source="components/content/content-excerpt.astro"
			>
				<ContentExcerpt entryUrl="#excerpt">
					<Fragment slot="excerpt-title">An excerpt title, linked to its Entry</Fragment>
					<Fragment slot="excerpt-subtitle">
						<ContentDate date={sampleDate} datePreset={DatePresetEnum.Long} />
						<span>
							example.com <span aria-hidden="true">↗</span>
						</span>
					</Fragment>
					<ProseSample />
				</ContentExcerpt>
			</Specimen>
			<Specimen
				bleed={true}
				name="content-note-links"
				note="The outbound links a Note points at, with the Source credited on the first."
				source="components/content/content-note-links.astro"
			>
				<ContentNoteLinks links={sampleLinks} source={sampleSource} />
			</Specimen>
			<Specimen
				bleed={true}
				name="section-backlinks"
				note="Inbound Links, capped at ten, newest first."
				source="components/sections/section-backlinks.astro"
			>
				<SectionBacklinks backlinks={sampleCatalogItems} />
			</Specimen>
			<Specimen
				bleed={true}
				name="section-related-content"
				note="The writing that points at a Project."
				source="components/sections/section-related-content.astro"
			>
				<SectionRelatedContent entries={sampleCatalogItems} />
			</Specimen>
			<Specimen
				bleed={true}
				name="section-pagination"
				note="Previous and next within one collection. Each arm renders alone when the other end is missing."
				source="components/sections/section-pagination.astro"
			>
				<SectionPagination
					baseUrl="#navigation"
					labelPlural={t('collection.posts.plural')}
					labelSingular={t('collection.posts.singular')}
					newerEntry={samplePaginationNewer}
					olderEntry={samplePaginationOlder}
				/>
				<SectionPagination
					baseUrl="#navigation"
					labelPlural={t('collection.notes.plural')}
					labelSingular={t('collection.notes.singular')}
					newerEntry={undefined}
					olderEntry={samplePaginationOlder}
				/>
			</Specimen>
		</Section>
		<Section
			note="Drawn by a batch script rather than by Astro; this route renders that template on demand."
			title="Open Graph"
		>
			{openGraphSpecimens.map(({ key, missing, name, note }) => {
				const card = sampleOpenGraphCards.find((item) => item.key === key);

				return (
					<Specimen name={name} note={note} source="packages/scripts/src/og-image/element.tsx">
						{card ? (
							<img
								alt={card.title}
								class="h-auto w-full"
								height={openGraphImageHeight}
								loading="lazy"
								src={`/inventory/og/${card.key}.jpg`}
								width={openGraphImageWidth}
							/>
						) : (
							<p class="font-mono text-xs text-primary-500">{missing}</p>
						)}
					</Specimen>
				);
			})}
		</Section>
	</div>
</MainSite>
