---
interface Props {
	title: string;
}

const { title } = Astro.props;

const id = title.toLowerCase();
---

<section class="mt-16 scroll-mt-8" id={id}>
	<h2
		class="content-column flex items-center gap-3 font-mono text-base font-medium text-primary-800"
	>
		{title}
		<span aria-hidden="true" class="h-0.5 flex-1 bg-primary-300"></span>
	</h2>
	<slot />
</section>
