---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { PaginationEntry } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentSectionReferences from '#components/content/content-section-references.astro';
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import ProseBody from '#components/parts/prose-body.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionPagination from '#components/sections/section-pagination.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	entry: CollectionEntry<'notes' | 'posts'>;
	newerEntry: PaginationEntry | undefined;
	olderEntry: PaginationEntry | undefined;
}

const { backlinks, entry, newerEntry, olderEntry } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(entry);

const isPost = entry.collection === 'posts';

const minutesRead =
	isPost && typeof remarkPluginFrontmatter.minutesRead === 'number'
		? remarkPluginFrontmatter.minutesRead
		: undefined;
---

<ContentEntryDetail entry={entry} hasReadingBar={isPost} isArticle={true}>
	<Fragment slot="header-subtitle-start">
		{isPost ? undefined : (
			<DividedItem>
				<Anchor anchorColor="accent" class="font-semibold uppercase" href={getSitePath('notes')}>
					{t('collection.notes.plural')}
				</Anchor>
			</DividedItem>
		)}
	</Fragment>
	<Fragment slot="header-subtitle-end">
		{minutesRead ? (
			<DividedItem>{formatStringTemplate(t('content.minutesRead'), { minutesRead })}</DividedItem>
		) : undefined}
	</Fragment>
	<ProseBody class:list={['e-content', 'pb-4']} data-reading-frame={isPost || undefined}>
		<Content />
	</ProseBody>
	<ContentSectionReferences projects={entry.data.projects} tags={entry.data.tags} />
	<SectionBacklinks backlinks={backlinks} slot="after-article" />
	<SectionPagination
		collection={entry.collection}
		newerEntry={newerEntry}
		olderEntry={olderEntry}
		slot="after-article"
	/>
</ContentEntryDetail>
