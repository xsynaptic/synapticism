---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentThumbnail from '#components/content/content-thumbnail.astro';
import MainSite from '#components/main/main-site.astro';
import DateDisplay from '#components/parts/date-display.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { getContentUrl, getSiteUrl } from '#lib/utils/routing.ts';
import { buildWebSiteSchema } from '#lib/utils/structured-data.ts';
import { formatStringTemplate, getSourceDomain } from '#lib/utils/text.ts';

interface Props {
	pageNumber: number;
	selectedProjects: Array<CatalogItem> | undefined;
	streamItems: Array<CatalogItem>;
	totalPages: number;
}

const { pageNumber, selectedProjects, streamItems, totalPages } = Astro.props;

const isFirstPage = pageNumber === 1;

let previousUrl: string | undefined;

if (!isFirstPage) {
	previousUrl = pageNumber === 2 ? getSiteUrl() : getSiteUrl('page', String(pageNumber - 1));
}

const nextUrl = pageNumber < totalPages ? getSiteUrl('page', String(pageNumber + 1)) : undefined;

const mainProps = isFirstPage
	? {
			schemas: [
				buildWebSiteSchema({
					description: t('site.description'),
					name: t('site.title'),
				}),
			],
		}
	: {
			meta: {
				noIndex: true,
				title: formatStringTemplate(t('index.pageTitle'), { page: pageNumber }),
			},
		};

const showHeadline = false as boolean;
const showProjects = false as boolean;
---

<MainSite isHomepage={true} {...mainProps}>
	{
		isFirstPage && showHeadline ? (
			<section class="content-column pt-8 pb-2 md:pt-14">
				<p class="max-w-[28ch] text-2xl leading-tight font-semibold text-balance text-primary-800 md:text-[clamp(1.65rem,1.2rem+1.6vw,2.15rem)]">
					{t('index.heroHeading')}
				</p>
				<p class="mt-4 max-w-[60ch] text-base leading-relaxed text-pretty text-primary-600 md:text-lg">
					{t('index.heroSubtitle')}
				</p>
				<p class="mt-5 font-mono text-xs text-primary-600">
					<span aria-hidden="true" class="text-accent-700">
						//
					</span>{' '}
					{t('index.tagline')}
				</p>
			</section>
		) : undefined
	}
	{
		streamItems.length > 0 ? (
			<section
				class:list={['content-column', isFirstPage ? 'mt-14 pb-8 md:mt-20' : 'pt-8 md:pt-14']}
			>
				<div class="flex items-center gap-4">
					<h2 class="font-mono text-sm font-medium text-primary-600">{t('index.recently')}</h2>
					<span aria-hidden="true" class="h-px flex-1 bg-primary-200" />
				</div>
				<ul class="mt-6 flex flex-col">
					{streamItems.map((item, index) => {
						const primaryLink = item.links?.[0];

						return (
							<li class={index > 0 ? 'mt-7 border-t border-primary-200/70 pt-7' : undefined}>
								<article class="flex gap-3 sm:gap-4">
									{item.imageId ? (
										<ContentThumbnail imgAlt={item.title} src={item.imageId} />
									) : undefined}
									<div class="flex min-w-0 flex-col gap-2">
										<h3 class="text-xl leading-snug font-semibold text-balance md:text-2xl">
											<a
												class="text-primary-800 transition-colors duration-200 hover:text-accent-700"
												href={item.url}
											>
												{item.title}
											</a>
										</h3>
										<div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-primary-600">
											<DateDisplay date={item.dateCreated} datePreset={DatePresetEnum.Medium} />
											{primaryLink ? (
												<span>
													{getSourceDomain(primaryLink.url)} <span aria-hidden="true">↗</span>
												</span>
											) : undefined}
										</div>
										{item.description ? (
											<p
												class="max-w-[68ch] leading-relaxed text-pretty text-primary-600"
												set:html={item.description}
											/>
										) : undefined}
									</div>
								</article>
							</li>
						);
					})}
				</ul>
				{totalPages > 1 ? (
					<nav
						aria-label={t('aria.streamPagination')}
						class="mt-10 flex justify-between font-mono text-sm"
					>
						{previousUrl ? (
							<a
								class="text-accent-700 transition-colors duration-200 hover:text-accent-600"
								href={previousUrl}
							>
								<span aria-hidden="true">&larr;</span> {t('index.newer')}
							</a>
						) : (
							<span />
						)}
						{nextUrl ? (
							<a
								class="text-accent-700 transition-colors duration-200 hover:text-accent-600"
								href={nextUrl}
							>
								{t('index.older')} <span aria-hidden="true">&rarr;</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				) : undefined}
			</section>
		) : undefined
	}
	{
		isFirstPage && showProjects && selectedProjects && selectedProjects.length > 0 ? (
			<section class="content-column mt-14 pb-8 md:mt-20">
				<div class="flex items-center gap-4">
					<h2 class="font-mono text-sm font-medium text-primary-600">{t('index.selectedWork')}</h2>
					<span aria-hidden="true" class="h-px flex-1 bg-primary-200" />
				</div>
				<ul class="mt-6 flex flex-col gap-5">
					{selectedProjects.map((item) => (
						<li>
							<article class="grid gap-x-6 gap-y-1 sm:grid-cols-[minmax(0,13rem)_1fr] sm:items-baseline">
								<h3 class="font-mono text-base font-medium">
									<a
										class="text-primary-800 transition-colors duration-200 hover:text-accent-700"
										href={item.url}
									>
										{item.title}
									</a>
								</h3>
								{item.description ? (
									<p
										class="max-w-[60ch] text-sm leading-relaxed text-pretty text-primary-600"
										set:html={item.description}
									/>
								) : undefined}
							</article>
						</li>
					))}
				</ul>
				<p class="mt-7 font-mono text-sm">
					<a
						class="text-accent-700 transition-colors duration-200 hover:text-accent-600"
						href={getContentUrl('projects')}
					>
						{t('index.allProjects')} <span aria-hidden="true">&rarr;</span>
					</a>
				</p>
			</section>
		) : undefined
	}
</MainSite>
