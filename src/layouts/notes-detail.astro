---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { NoteNavItem } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentDate from '#components/content/content-date.astro';
import ContentHeader from '#components/content/content-header.astro';
import ContentHero from '#components/content/content-hero.astro';
import ContentNoteLinks from '#components/content/content-note-links.astro';
import ContentSectionProjects from '#components/content/content-section-projects.astro';
import ContentSectionTags from '#components/content/content-section-tags.astro';
import MainSite from '#components/main/main-site.astro';
import DividedItem from '#components/parts/divided-item.astro';
import Link from '#components/parts/link.astro';
import ProseBody from '#components/parts/prose-body.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionNoteNav from '#components/sections/section-note-nav.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { SITE_AUTHOR_NAME } from '#constants.ts';
import { getNoteSchema } from '#lib/collections/notes/notes-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { getDescriptionRenderedText } from '#lib/utils/description.ts';
import { getPagefindBodyProp } from '#lib/utils/pagefind.ts';
import { getSiteUrl } from '#lib/utils/routing.ts';
import { getOgImageUrl, getSeoArticleProps } from '#lib/utils/seo.ts';

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	entry: CollectionEntry<'notes'>;
	newerNote: NoteNavItem | undefined;
	olderNote: NoteNavItem | undefined;
}

const { backlinks, entry, newerNote, olderNote } = Astro.props;

const projectIds = entry.data.projects?.map(({ id }) => id);
const tagIds = entry.data.tags?.map(({ id }) => id);

const { Content } = await render(entry);
---

<MainSite
	meta={{
		description: getDescriptionRenderedText(entry),
		image: { url: getOgImageUrl(entry.collection, entry.id) },
		title: entry.data.title,
		...getSeoArticleProps({
			dateCreated: entry.data.dateCreated,
			dateUpdated: entry.data.dateUpdated,
		}),
	}}
	schemas={getNoteSchema(entry, { authorName: SITE_AUTHOR_NAME, url: Astro.url.toString() })}
>
	<article class:list={['entry-detail', MicroformatClassNames.Entry]} {...getPagefindBodyProp()}>
		<ContentHeader title={entry.data.title}>
			<Fragment slot="header-subtitle">
				<DividedItem
					class="font-mono text-xs font-medium500 uppercase"
					dividerContent="slash"
					><Link color="accent" href={getSiteUrl('notes')}>{t('collection.notes')}</Link></DividedItem
				>
				<DividedItem class="font-mono text-xs text-primary-500">
					<ContentDate
						date={entry.data.dateCreated}
						datePreset={DatePresetEnum.Medium}
						showMicroformats={true}
					/>
				</DividedItem>
				{
					entry.data.dateUpdated ? (
						<DividedItem>
							<ContentDate
								date={entry.data.dateUpdated}
								datePreset={DatePresetEnum.Medium}
								showMicroformats={true}
								showUpdated={true}
							/>
						</DividedItem>
					) : undefined
				}
			</Fragment>
		</ContentHeader>
		{
			entry.data.imageHero ? (
				<ContentHero alt={entry.data.imageAlt ?? ''} src={entry.data.imageHero} />
			) : undefined
		}
		<ProseBody class:list={['content', 'e-content', 'pb-4']}>
			<Content />
		</ProseBody>
		<ContentNoteLinks links={entry.data.links} source={entry.data.source} />
		<ContentSectionProjects projectIds={projectIds} />
		<ContentSectionTags tagIds={tagIds} />
	</article>
	<SectionBacklinks backlinks={backlinks} />
	<SectionNoteNav newer={newerNote} older={olderNote} />
</MainSite>
