---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import ContentHeader from '#components/content/content-header.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import DateDisplay from '#components/parts/date-display.astro';
import Link from '#components/parts/link.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import Pagination from '#components/parts/pagination.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum, parseContentDate } from '#lib/utils/date.ts';
import { getContentUrl } from '#lib/utils/routing.ts';
import { getEntryDescription, getSourceDomain } from '#lib/utils/text.ts';

interface Props {
	page: Page<CollectionEntry<'notes'>>;
}

const { page } = Astro.props;
---

<MainSite
	meta={{
		description: t('notes.description'),
		noIndex: page.currentPage > 1,
		title: t('notes.title'),
	}}
>
	<ContentHeader title={t('notes.title')}>
		<Fragment slot="header-subtitle"><PaginationCounter page={page} /></Fragment>
	</ContentHeader>
	<ContentSection>
		<ul class="flex flex-col gap-4">
			{
				page.data.map((entry) => {
					const dateCreated = parseContentDate(entry.data.dateCreated);
					const description = getEntryDescription(entry);
					const primaryLink = entry.data.links?.[0];

					return (
						<li class="flex flex-col gap-1">
							<h2 class="text-lg font-semibold md:text-xl">
								<Link href={getContentUrl(entry.collection, entry.id)}>{entry.data.title}</Link>
							</h2>
							<div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-primary-600">
								{dateCreated ? (
									<DateDisplay date={dateCreated} datePreset={DatePresetEnum.Medium} />
								) : undefined}
								{primaryLink ? (
									<span>
										{getSourceDomain(primaryLink.url)}
										<span aria-hidden="true" class="ml-1">
											↗
										</span>
									</span>
								) : undefined}
							</div>
							{description ? <p class="text-sm text-primary-600">{description}</p> : undefined}
						</li>
					);
				})
			}
		</ul>
		<Pagination class="mt-small md:mt-medium" page={page} />
	</ContentSection>
</MainSite>
