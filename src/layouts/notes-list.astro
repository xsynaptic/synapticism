---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import ContentExcerpt from '#components/content/content-excerpt.astro';
import ContentHeader from '#components/content/content-header.astro';
import MainSite from '#components/main/main-site.astro';
import DateDisplay from '#components/parts/date-display.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import Pagination from '#components/parts/pagination.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { getContentUrl } from '#lib/utils/routing.ts';
import { getSourceDomain } from '#lib/utils/text.ts';

interface Props {
	page: Page<CollectionEntry<'notes'>>;
}

const { page } = Astro.props;

const items = await Promise.all(
	page.data.map(async (entry) => {
		const { Content } = await render(entry);

		return { Content, entry };
	}),
);
---

<MainSite
	meta={{
		description: t('notes.description'),
		noIndex: page.currentPage > 1,
		title: t('notes.title'),
	}}
>
	<ContentHeader title={t('notes.title')}>
		<Fragment slot="header-subtitle"><PaginationCounter page={page} /></Fragment>
	</ContentHeader>
	<div class={MicroformatClassNames.Feed}>
		{
			items.map(({ Content, entry }) => {
				const primaryLink = entry.data.links?.[0];

				return (
					<ContentExcerpt class="mb-8" entryUrl={getContentUrl('notes', entry.id)}>
						<Fragment slot="excerpt-title">{entry.data.title}</Fragment>
						<Fragment slot="excerpt-subtitle">
							<DateDisplay
								class={MicroformatClassNames.DatePublished}
								date={entry.data.dateCreated}
								datePreset={DatePresetEnum.Medium}
							/>
							{primaryLink ? (
								<span>
									{getSourceDomain(primaryLink.url)}
									<span aria-hidden="true" class="ml-1">
										↗
									</span>
								</span>
							) : undefined}
						</Fragment>
						<Content />
					</ContentExcerpt>
				);
			})
		}
	</div>
	<div class="content-column">
		<Pagination class="mt-4 mb-8 md:mt-8" page={page} />
	</div>
</MainSite>
