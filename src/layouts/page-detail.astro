---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import ContentEntryDetail from '#components/content/content-entry-detail.astro';

interface Props {
	entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);
---

<ContentEntryDetail entry={entry} hasReadingBar={true} isArticle={false}>
	<Content />
</ContentEntryDetail>
