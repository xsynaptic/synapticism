---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { PaginationEntry } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentSectionReferences from '#components/content/content-section-references.astro';
import PostSubtitle from '#components/content/post-subtitle.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionPagination from '#components/sections/section-pagination.astro';
import { getPostMinutesRead } from '#lib/collections/posts/posts-utils.ts';

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	entry: CollectionEntry<'posts'>;
	newerEntry: PaginationEntry | undefined;
	olderEntry: PaginationEntry | undefined;
}

const { backlinks, entry, newerEntry, olderEntry } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(entry);

const minutesRead = getPostMinutesRead(remarkPluginFrontmatter);
---

<ContentEntryDetail entry={entry} hasReadingBar={minutesRead !== undefined} isArticle={true}>
	<PostSubtitle entry={entry} minutesRead={minutesRead} slot="header-subtitle" />
	<Content />
	<ContentSectionReferences
		projects={entry.data.projects}
		slot="after-body"
		tags={entry.data.tags}
	/>
	<SectionBacklinks backlinks={backlinks} slot="after-article" />
	<SectionPagination newerEntry={newerEntry} olderEntry={olderEntry} slot="after-article" />
</ContentEntryDetail>
