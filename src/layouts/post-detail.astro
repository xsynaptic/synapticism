---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { ContentNavigationItem } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentDate from '#components/content/content-date.astro';
import ContentHeader from '#components/content/content-header.astro';
import ContentHero from '#components/content/content-hero.astro';
import ContentSectionProjects from '#components/content/content-section-projects.astro';
import ContentSectionTags from '#components/content/content-section-tags.astro';
import MainSite from '#components/main/main-site.astro';
import AuthorCard from '#components/parts/author-card.astro';
import DividedItem from '#components/parts/divided-item.astro';
import ProseBody from '#components/parts/prose-body.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionNavigation from '#components/sections/section-navigation.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { siteAuthorName } from '#constants.ts';
import { getPostSchema } from '#lib/collections/posts/posts-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { getDescriptionRenderedText } from '#lib/utils/description.ts';
import { getImageFeaturedHeroGroup } from '#lib/utils/image-featured.ts';
import { getPagefindBodyProp } from '#lib/utils/pagefind.ts';
import { getContentUrl } from '#lib/utils/routing.ts';
import { getOgImageUrl, getSeoArticleProps } from '#lib/utils/seo.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	entry: CollectionEntry<'posts'>;
	newerItem: ContentNavigationItem | undefined;
	olderItem: ContentNavigationItem | undefined;
}

const { backlinks, entry, newerItem, olderItem } = Astro.props;

const projectIds = entry.data.projects?.map(({ id }) => id);
const tagIds = entry.data.tags?.map(({ id }) => id);

const imageFeaturedHeroGroup = getImageFeaturedHeroGroup({
	imageFeatured: entry.data.imageFeatured,
});

const { Content, remarkPluginFrontmatter } = await render(entry);

const minutesRead =
	typeof remarkPluginFrontmatter.minutesRead === 'number'
		? remarkPluginFrontmatter.minutesRead
		: undefined;
---

<MainSite
	hasReadingBar={true}
	meta={{
		description: getDescriptionRenderedText(entry),
		image: { url: getOgImageUrl(entry.collection, entry.id) },
		title: entry.data.title,
		...getSeoArticleProps({
			dateCreated: entry.data.dateCreated,
			dateUpdated: entry.data.dateUpdated,
		}),
	}}
	schemas={getPostSchema(entry, { authorName: siteAuthorName, url: Astro.url.toString() })}
>
	<article class:list={['pb-8', MicroformatClassNames.Entry]} {...getPagefindBodyProp()}>
		<ContentHeader title={entry.data.title} titleUrl={Astro.url.toString()}>
			<Fragment slot="header-subtitle">
				<DividedItem>
					<ContentDate
						date={entry.data.dateCreated}
						datePreset={DatePresetEnum.Long}
						showMicroformats={true}
					/>
				</DividedItem>
				{
					entry.data.dateUpdated ? (
						<DividedItem>
							<ContentDate
								date={entry.data.dateUpdated}
								datePreset={DatePresetEnum.Long}
								showMicroformats={true}
								showUpdated={true}
							/>
						</DividedItem>
					) : undefined
				}
				{
					minutesRead ? (
						<DividedItem>
							{formatStringTemplate(t('content.minutesRead'), { minutesRead })}
						</DividedItem>
					) : undefined
				}
			</Fragment>
		</ContentHeader>
		{
			imageFeaturedHeroGroup?.[0] ? (
				<ContentHero {...imageFeaturedHeroGroup[0]} fallbackAlt={entry.data.title} />
			) : undefined
		}
		<ProseBody class:list={['e-content', 'pb-4']} data-reading-frame>
			<Content />
		</ProseBody>
		<ContentSectionProjects projectIds={projectIds} />
		<ContentSectionTags tagIds={tagIds} />
		<AuthorCard />
	</article>
	<SectionBacklinks backlinks={backlinks} />
	<SectionNavigation
		baseUrl={getContentUrl('posts')}
		labelPLural={t('collection.posts.plural')}
		labelSingular={t('collection.posts.singular')}
		newerItem={newerItem}
		olderItem={olderItem}
	/>
</MainSite>
