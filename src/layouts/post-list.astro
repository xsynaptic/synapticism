---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import ContentHeader from '#components/content/content-header.astro';
import PostExcerptList from '#components/content/post-excerpt-list.astro';
import MainSite from '#components/main/main-site.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getPagePagination } from '#lib/utils/pagination.ts';
import { openGraphIndexIds } from '#lib/utils/seo.ts';

interface Props {
	page: Page<CollectionEntry<'posts'>>;
}

const { page } = Astro.props;
---

<MainSite
	meta={{
		description: t('posts.description'),
		openGraphId: openGraphIndexIds.posts,
		title: t('posts.title'),
	}}
>
	<ContentHeader class="mb-6" title={t('posts.title')}>
		<Fragment slot="header-subtitle">
			<PaginationCounter page={page} />
		</Fragment>
	</ContentHeader>
	<PostExcerptList entries={page.data} pagination={getPagePagination(page)} />
</MainSite>
