---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import ContentListView from '#components/content/content-list-view.astro';
import PostExcerptList from '#components/content/post-excerpt-list.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getPagePagination } from '#lib/utils/pagination.ts';
import { getIndexOpenGraphCard } from '#lib/utils/seo.ts';

interface Props {
	page: Page<CollectionEntry<'posts'>>;
}

const { page } = Astro.props;
---

<ContentListView
	description={t('posts.description')}
	openGraphCard={getIndexOpenGraphCard('posts', t('posts.title'))}
	page={page}
	title={t('posts.title')}
>
	<PostExcerptList entries={page.data} pagination={getPagePagination(page)} />
</ContentListView>
