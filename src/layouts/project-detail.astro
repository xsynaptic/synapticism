---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentSectionReferences from '#components/content/content-section-references.astro';
import SectionEntryList from '#components/sections/section-entry-list.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	entry: CollectionEntry<'projects'>;
	relatedContent: Array<CatalogItem> | undefined;
}

const { entry, relatedContent } = Astro.props;

const { Content } = await render(entry);
---

<ContentEntryDetail
	entry={entry}
	hasReadingBar={true}
	isArticle={false}
	template={entry.data.template}
>
	<Content />
	<ContentSectionReferences slot="after-body" tags={entry.data.tags} />
	<SectionEntryList
		entries={relatedContent}
		slot="after-article"
		title={t('section.relatedWriting')}
	/>
</ContentEntryDetail>
