---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentSectionReferences from '#components/content/content-section-references.astro';
import ProseBody from '#components/parts/prose-body.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionEntryList from '#components/sections/section-entry-list.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	entry: CollectionEntry<'projects'>;
	relatedContent: Array<CatalogItem> | undefined;
}

const { backlinks, entry, relatedContent } = Astro.props;

const { Content } = await render(entry);
---

<ContentEntryDetail entry={entry} hasReadingBar={true} isArticle={false}>
	<ProseBody class:list={['e-content', 'pb-4']} data-reading-frame>
		<Content />
	</ProseBody>
	<ContentSectionReferences tags={entry.data.tags} />
	<Fragment slot="after-article">
		<SectionEntryList entries={relatedContent} title={t('section.relatedWriting')} />
		<SectionBacklinks backlinks={backlinks} />
	</Fragment>
</ContentEntryDetail>
