---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import ContentListView from '#components/content/content-list-view.astro';
import ContentSection from '#components/content/content-section.astro';
import ProjectCard from '#components/content/project-card.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getPagePagination } from '#lib/utils/pagination.ts';
import { getIndexOpenGraphCard } from '#lib/utils/seo.ts';

interface Props {
	page: Page<CollectionEntry<'projects'>>;
}

const { page } = Astro.props;
---

<ContentListView
	description={t('projects.description')}
	openGraphCard={getIndexOpenGraphCard('projects', t('projects.title'))}
	title={t('projects.title')}
>
	<ContentSection>
		<div class:list={['flex flex-col', MicroformatClassNames.Feed]}>
			{page.data.map((entry, index) => (
				<Fragment>
					{index > 0 ? <hr class="my-8 border-primary-300/70 md:my-10" /> : undefined}
					<ProjectCard entry={entry} isPriority={index === 0} />
				</Fragment>
			))}
		</div>
		<PaginationSelect class="mt-8" pagination={getPagePagination(page)} />
	</ContentSection>
</ContentListView>
