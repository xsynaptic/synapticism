---
import type { Page } from 'astro';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentHeader from '#components/content/content-header.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import DateDisplay from '#components/parts/date-display.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import PreviewImage from '#components/parts/preview-image.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { openGraphIndexIds } from '#lib/utils/seo.ts';

interface Props {
	page: Page<CatalogItem>;
}

const { page } = Astro.props;
---

<MainSite
	meta={{
		description: t('projects.description'),
		noIndex: page.currentPage > 1,
		openGraphId: openGraphIndexIds.projects,
		title: t('projects.title'),
	}}
>
	<ContentHeader title={t('projects.title')}>
		<Fragment slot="header-subtitle"><PaginationCounter page={page} /></Fragment>
	</ContentHeader>
	<ContentSection>
		<ul class="flex flex-col gap-4">
			{
				page.data.map((item) => (
					<li class="flex gap-3 sm:gap-4">
						{item.imageId ? <PreviewImage imgAlt={item.title} src={item.imageId} /> : undefined}
						<div class="flex min-w-0 flex-col gap-1">
							<h2 class="text-lg font-semibold md:text-xl">
								<Anchor anchorColor="title" href={item.url}>
									{item.title}
								</Anchor>
							</h2>
							<DateDisplay
								class="text-xs text-primary-400"
								date={item.dateCreated}
								datePreset={DatePresetEnum.Long}
							/>
							{item.description ? (
								<p class="text-sm text-primary-500" set:html={item.description} />
							) : undefined}
						</div>
					</li>
				))
			}
		</ul>
		<PaginationSelect class="mt-4 md:mt-8" page={page} />
	</ContentSection>
</MainSite>
