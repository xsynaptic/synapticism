---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';
import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ContentDescription from '#components/content/content-description.astro';
import ContentListView from '#components/content/content-list-view.astro';
import PostExcerptList from '#components/content/post-excerpt-list.astro';
import SectionEntryList from '#components/sections/section-entry-list.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getDescriptionRenderedText } from '#lib/utils/description-data.ts';
import { getPagePagination } from '#lib/utils/pagination.ts';
import { getEntryOpenGraphCard } from '#lib/utils/seo.ts';

interface Props {
	entry: ComputedEntry<'tags'>;
	page: Page<CollectionEntry<'posts'>>;
	projects: Array<CatalogItem>;
}

const { entry, page, projects } = Astro.props;
---

<ContentListView
	description={getDescriptionRenderedText(entry)}
	openGraphCard={getEntryOpenGraphCard(entry)}
	page={page}
	title={entry.data.title}
>
	<ContentDescription entry={entry} />
	<PostExcerptList entries={page.data} pagination={getPagePagination(page)} />
	{page.currentPage === 1 ? (
		<SectionEntryList entries={projects} title={t('section.projects')} />
	) : undefined}
</ContentListView>
