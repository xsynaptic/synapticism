---
import type { CollectionEntry } from 'astro:content';

import ContentHeader from '#components/content/content-header.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import ListRow from '#components/parts/list-row.astro';
import { groupTagsByLetter } from '#lib/collections/tags/tags-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	tags: Array<CollectionEntry<'tags'>>;
}

const { tags } = Astro.props;

const groups = groupTagsByLetter(tags);
---

<MainSite
	meta={{
		description: t('tags.description'),
		title: t('tags.title'),
	}}
>
	<ContentHeader title={t('tags.title')} />
	<ContentSection>
		{
			groups.length > 0 ? (
				<div class="flex flex-col gap-8">
					{groups.map((group) => (
						<section class="flex flex-col gap-2">
							<h2 class="font-mono text-sm font-semibold text-primary-400">{group.letter}</h2>
							<ListRow>
								{group.tags.map((tag) => (
									<DividedItem as="li" class="divided-thin font-serif text-sm">
										<Anchor href={getContentUrl(tag.collection, tag.id)}>
											{tag.data.title}
											{tag.data._entryCount ? (
												<>
													{' '}
													<span class="text-xs text-primary-400">
														({String(tag.data._entryCount)})
													</span>
												</>
											) : undefined}
										</Anchor>
									</DividedItem>
								))}
							</ListRow>
						</section>
					))}
				</div>
			) : (
				<p class="text-sm text-primary-500">{t('tags.empty')}</p>
			)
		}
	</ContentSection>
</MainSite>
