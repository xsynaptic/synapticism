---
import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ContentHeader from '#components/content/content-header.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import ChipRow from '#components/parts/chip-row.astro';
import { groupTagsByLetter } from '#lib/collections/tags/tags-utils.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getContentPath } from '#lib/utils/routing.ts';
import { getIndexOpenGraphCard } from '#lib/utils/seo.ts';

interface Props {
	tags: Array<ComputedEntry<'tags'>>;
}

const { tags } = Astro.props;

const groups = groupTagsByLetter(tags);
---

<MainSite
	meta={{
		description: t('tags.description'),
		openGraphCard: getIndexOpenGraphCard('tags', {
			description: t('tags.description'),
			title: t('tags.title'),
		}),
		title: t('tags.title'),
	}}
>
	<ContentHeader title={t('tags.title')} />
	<ContentSection>
		{groups.length > 0 ? (
			<div class="flex flex-col gap-8">
				{groups.map((group) => (
					<section class="flex flex-col gap-2">
						<h2 class="font-mono text-sm font-semibold text-primary-400">{group.letter}</h2>
						<ChipRow
							items={group.tags.map((tag) => ({
								count: tag.data._entryCount > 0 ? tag.data._entryCount : undefined,
								title: tag.data.title,
								url: getContentPath(tag.collection, tag.id),
							}))}
						/>
					</section>
				))}
			</div>
		) : (
			<p class="text-sm text-primary-500">{t('tags.empty')}</p>
		)}
	</ContentSection>
</MainSite>
