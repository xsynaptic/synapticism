---
import type { CollectionEntry } from 'astro:content';

import ContentHeader from '#components/content/content-header.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import DividedItem from '#components/parts/divided-item.astro';
import Link from '#components/parts/link.astro';
import ListRow from '#components/parts/list-row.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	tags: Array<CollectionEntry<'tags'>>;
}

const { tags } = Astro.props;
---

<MainSite
	meta={{
		description: t('tags.description'),
		title: t('tags.title'),
	}}
>
	<ContentHeader>
		<Fragment slot="header-title">{t('tags.title')}</Fragment>
	</ContentHeader>
	<ContentSection>
		{
			tags.length > 0 ? (
				<ListRow>
					{tags.map((tag) => (
						<DividedItem as="li" class="font-serif text-sm after:text-sm after:font-light">
							<Link href={getContentUrl(tag.collection, tag.id)}>
								{tag.data.title}
								{tag.data._postCount ? (
									<span class="text-xs text-primary-400">({String(tag.data._postCount)})</span>
								) : undefined}
							</Link>
						</DividedItem>
					))}
				</ListRow>
			) : (
				<p class="text-sm text-primary-500">{t('tags.empty')}</p>
			)
		}
	</ContentSection>
</MainSite>
