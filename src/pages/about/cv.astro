---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'yaml';
import { z } from 'zod';

import MainSite from '#components/main/main-site.astro';
import Container from '#components/parts/container.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

const ResumeDataSchema = z.object({
	basics: z.object({
		email: z.email(),
		label: z.string(),
		location: z.object({
			city: z.string(),
			countryCode: z.string(),
			region: z.string(),
		}),
		name: z.string(),
		profiles: z
			.object({
				network: z.string(),
				url: z.url(),
			})
			.array(),
		summary: z.string(),
		website: z.url(),
	}),
	education: z
		.object({
			area: z.string(),
			degree: z.string(),
			institution: z.string(),
		})
		.array(),
	projects: z
		.object({
			description: z.string(),
			highlights: z.array(z.string()),
			name: z.string(),
			repo: z.url().optional(),
			url: z.url(),
		})
		.array(),
	skills: z
		.object({
			category: z.string(),
			items: z.array(z.string()),
		})
		.array(),
	work: z
		.object({
			company: z.string(),
			endDate: z.string().optional(),
			highlights: z.array(z.string()),
			location: z.string(),
			position: z.string(),
			startDate: z.string(),
		})
		.array(),
});

type Resume = z.infer<typeof ResumeDataSchema>;

function getResume(): Resume {
	const filePath = path.resolve('packages/content/data/resume.yaml');
	const fileContents = fs.readFileSync(filePath, 'utf8');
	const data = yaml.parse(fileContents);

	return ResumeDataSchema.parse(data);
}

const resume = getResume();

const { basics, education, projects, skills, work } = resume;
---

<MainSite>
	<Container as="article" class="my-8">
		<header class="flex flex-col gap-1 py-1">
			<div class="flex items-center justify-between gap-2">
				<h1 class="text-2xl font-semibold sm:text-4xl">{basics.name}</h1>
				<div class="flex items-center gap-2 text-sm text-neutral-500">
					{
						basics.profiles.map((profile) => (
							<a class="print:hidden" href={profile.url}>
								{profile.network}
							</a>
						))
					}
				</div>
			</div>
			<div>{basics.location.city}, {basics.location.region}</div>
			<div class="flex flex-col gap-1 text-sm text-neutral-500">
				<a href={`mailto:${basics.email}`}>{basics.email}</a>
			</div>
		</header>
		<section class="pt-1 pb-2 text-base">
			<p>{basics.summary}</p>
		</section>
		<section class="pt-1 pb-2 text-base">
			<h2 class="text-lg font-bold">{t('cv.skills')}</h2>
			<ul>
				{
					skills.map((skill) => (
						<li class="mb-1 ml-4 list-disc text-sm text-neutral-400">
							<span class="sr-only">{skill.category}:</span>
							<span class="text-neutral-700">{skill.items.join(', ')}</span>
						</li>
					))
				}
			</ul>
		</section>
		<section class="pt-1 pb-2 text-base">
			<h2 class="text-lg font-bold">{t('cv.experience')}</h2>
			{
				work.map((job) => (
					<div class="flex flex-col gap-2">
						<div class="flex items-center justify-between gap-2">
							<h3 class="font-semibold">
								{job.company}, <span class="italic">{job.position}</span>
							</h3>
							<span class="text-sm text-neutral-500">
								{new Date(job.startDate).toLocaleDateString('en-US', {
									month: 'long',
									year: 'numeric',
								})}
								&ndash;
								{job.endDate
									? new Date(job.endDate).toLocaleDateString('en-US', {
											month: 'long',
											year: 'numeric',
										})
									: t('cv.present')}
							</span>
						</div>
						<ul>
							{job.highlights.map((highlight) => (
								<li class="mb-1 ml-4 list-disc text-sm text-neutral-400">
									<span class="text-neutral-700">{highlight}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</section>
		<section class="pt-1 pb-2 text-base">
			<h2 class="text-lg font-bold">{t('cv.projects')}</h2>
			{
				projects.map((project) => (
					<div class="flex flex-col gap-2">
						<div class="flex flex-col gap-1">
							<div class="flex items-center justify-between gap-2">
								<h3 class="font-semibold">
									<a href={project.url}>{project.name}</a>:{' '}
									<span class="italic">{project.description}</span>
								</h3>
								{project.repo ? (
									<a class="text-sm text-neutral-500 print:hidden" href={project.repo}>
										{t('cv.github')}
									</a>
								) : undefined}
							</div>
							{project.url ? (
								<div class="flex flex-col gap-1 text-sm text-neutral-500">
									<a href={project.url}>{project.url}</a>
								</div>
							) : undefined}
						</div>
						<ul>
							{project.highlights.map((highlight) => (
								<li class="mb-1 ml-4 list-disc text-sm text-neutral-400">
									<span class="text-neutral-700">{highlight}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</section>
		<section class="pt-1 pb-2 text-base">
			<h2 class="text-lg font-bold">{t('cv.education')}</h2>
			{
				education.map((edu) => (
					<div>
						<span class="font-semibold">{edu.institution}</span>:{' '}
						<span>
							{edu.degree}, {edu.area}
						</span>
					</div>
				))
			}
		</section>
	</Container>
</MainSite>
