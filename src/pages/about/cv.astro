---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'yaml';
import { z } from 'zod';

import CvLayout from '#layouts/cv.astro';

const CvDataSchema = z.object({
	basics: z.object({
		email: z.email(),
		label: z.string(),
		location: z.object({
			city: z.string(),
			countryCode: z.string(),
			region: z.string(),
		}),
		name: z.string(),
		profiles: z
			.object({
				network: z.string(),
				url: z.url(),
			})
			.array(),
		summary: z.string(),
		website: z.url(),
	}),
	education: z
		.object({
			area: z.string(),
			degree: z.string(),
			institution: z.string(),
		})
		.array(),
	projects: z
		.object({
			description: z.string(),
			highlights: z.array(z.string()),
			name: z.string(),
			repo: z.url().optional(),
			url: z.url(),
		})
		.array(),
	skills: z
		.object({
			category: z.string(),
			items: z.array(z.string()),
		})
		.array(),
	work: z
		.object({
			company: z.string(),
			endDate: z.string().optional(),
			highlights: z.array(z.string()),
			location: z.string(),
			position: z.string(),
			startDate: z.string(),
		})
		.array(),
});

type Cv = z.infer<typeof CvDataSchema>;

function getCv(): Cv {
	const filePath = path.resolve('packages/content/data/cv.yaml');
	const fileContents = fs.readFileSync(filePath, 'utf8');
	const data = yaml.parse(fileContents);

	return CvDataSchema.parse(data);
}

const cv = getCv();
---

<CvLayout cv={cv} />
