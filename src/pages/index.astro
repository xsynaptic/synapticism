---
import * as R from 'remeda';

import IndexLayout from '#layouts/index.astro';
import { queryPostsIndex } from '#lib/collections/posts/utils.ts';
import { queryProjectsIndex } from '#lib/collections/projects/utils.ts';

const recentPosts = R.pipe(await queryPostsIndex(), R.take(5));
const recentProjects = await queryProjectsIndex();
---

<IndexLayout recentPosts={recentPosts} recentProjects={recentProjects} />
