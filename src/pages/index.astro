---
import { postListPageSize } from '#constants.ts';
import HomeLayout from '#layouts/home.astro';
import { queryPostEntries } from '#lib/collections/posts/posts-utils.ts';

const entries = await queryPostEntries();

const totalPages = Math.max(1, Math.ceil(entries.length / postListPageSize));
---

<HomeLayout entries={entries.slice(0, postListPageSize)} pageNumber={1} totalPages={totalPages} />
