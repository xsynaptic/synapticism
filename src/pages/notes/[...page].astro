---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import * as R from 'remeda';

import NoteIndex from '#layouts/notes-index.astro';
import { getNotesCollection } from '#lib/collections/notes/notes-data.js';
import { sortByDateReverseChronological } from '#lib/utils/date.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries } = await getNotesCollection();

	return paginate(R.sort(entries, sortByDateReverseChronological), { pageSize: 20 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<NoteIndex {...Astro.props} />
