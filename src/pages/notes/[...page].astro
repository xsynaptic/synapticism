---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import { articleListPageSize } from '#constants.ts';
import ArticleList from '#layouts/article-list.astro';
import { queryArticleEntries } from '#lib/utils/articles.ts';

export const getStaticPaths = (async ({ paginate }) => {
	return paginate(await queryArticleEntries(['notes']), { pageSize: articleListPageSize });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ArticleList collection="notes" page={Astro.props.page} />
