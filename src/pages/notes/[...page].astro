---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import NoteList from '#layouts/notes-list.astro';
import { getNotesCollection } from '#lib/collections/notes/notes-data.js';
import { sortByDateReverseChronological } from '#lib/utils/date.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries } = await getNotesCollection();

	return paginate([...entries].sort(sortByDateReverseChronological), { pageSize: 20 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<NoteList {...Astro.props} />
