---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import NoteDetail from '#layouts/notes-detail.astro';
import { getCatalog } from '#lib/catalog/catalog-data.js';
import { getNotesCollection } from '#lib/collections/notes/notes-data.js';
import { sortByDateReverseChronological } from '#lib/utils/date.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

export const getStaticPaths = (async () => {
	const { entries } = await getNotesCollection();
	const catalog = await getCatalog();

	const sorted = [...entries].sort(sortByDateReverseChronological);

	return sorted.map((entry, index) => {
		const newer = index > 0 ? sorted[index - 1] : undefined;
		const older = index < sorted.length - 1 ? sorted[index + 1] : undefined;

		return {
			params: { note: entry.id },
			props: {
				backlinks: catalog.backlinksOf(entry.id),
				entry,
				newerNote: newer
					? { title: newer.data.title, url: getContentUrl('notes', newer.id) }
					: undefined,
				olderNote: older
					? { title: older.data.title, url: getContentUrl('notes', older.id) }
					: undefined,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<NoteDetail {...Astro.props} />
