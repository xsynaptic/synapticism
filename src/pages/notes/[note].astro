---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ArticleDetail from '#layouts/article-detail.astro';
import { getCatalog } from '#lib/catalog/catalog-data.ts';
import { filterIsEditorialEntry } from '#lib/catalog/catalog-utils.ts';
import { getNotesCollection } from '#lib/collections/notes/notes-data.ts';
import { sortByDateReverseChronological } from '#lib/utils/date.ts';
import { getContentPath } from '#lib/utils/routing.ts';

export const getStaticPaths = (async () => {
	const { entries } = await getNotesCollection();
	const catalog = await getCatalog();

	const sorted = [...entries].sort(sortByDateReverseChronological);

	return sorted.map((entry, index) => {
		const newer = sorted[index - 1];
		const older = sorted[index + 1];

		return {
			params: { note: entry.id },
			props: {
				backlinks: catalog.backlinksOf(entry.id).filter(filterIsEditorialEntry),
				entry,
				newerEntry: newer
					? { title: newer.data.title, url: getContentPath('notes', newer.id) }
					: undefined,
				olderEntry: older
					? { title: older.data.title, url: getContentPath('notes', older.id) }
					: undefined,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ArticleDetail {...Astro.props} />
