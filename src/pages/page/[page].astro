---
import type { GetStaticPaths } from 'astro';

import * as R from 'remeda';

import { postListPageSize } from '#constants.ts';
import HomeLayout from '#layouts/home.astro';
import { queryPostEntries } from '#lib/collections/posts/posts-utils.ts';

export const getStaticPaths = (async () => {
	const entries = await queryPostEntries();

	const totalPages = Math.max(1, Math.ceil(entries.length / postListPageSize));

	return R.range(2, totalPages + 1).map((pageNumber) => {
		const start = (pageNumber - 1) * postListPageSize;

		return {
			params: { page: String(pageNumber) },
			props: {
				entries: entries.slice(start, start + postListPageSize),
				pageNumber,
				totalPages,
			},
		};
	});
}) satisfies GetStaticPaths;

const { entries, pageNumber, totalPages } = Astro.props;
---

<HomeLayout entries={entries} pageNumber={pageNumber} totalPages={totalPages} />
