---
import type { GetStaticPaths } from 'astro';

import * as R from 'remeda';

import { articleListPageSize } from '#constants.ts';
import HomeLayout from '#layouts/home.astro';
import { queryArticleEntries } from '#lib/utils/articles.ts';

export const getStaticPaths = (async () => {
	const entries = await queryArticleEntries(['posts', 'notes']);

	const totalPages = Math.max(1, Math.ceil(entries.length / articleListPageSize));

	return R.range(2, totalPages + 1).map((pageNumber) => {
		const start = (pageNumber - 1) * articleListPageSize;

		return {
			params: { page: String(pageNumber) },
			props: {
				entries: entries.slice(start, start + articleListPageSize),
				pageNumber,
				totalPages,
			},
		};
	});
}) satisfies GetStaticPaths;

const { entries, pageNumber, totalPages } = Astro.props;
---

<HomeLayout entries={entries} pageNumber={pageNumber} totalPages={totalPages} />
