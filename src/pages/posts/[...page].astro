---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import { postListPageSize } from '#constants.ts';
import PostList from '#layouts/post-list.astro';
import { queryPostEntries } from '#lib/collections/posts/posts-utils.ts';

export const getStaticPaths = (async ({ paginate }) => {
	return paginate(await queryPostEntries(), { pageSize: postListPageSize });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<PostList page={Astro.props.page} />
