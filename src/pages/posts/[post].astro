---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import PostDetail from '#layouts/post-detail.astro';
import { getCatalog } from '#lib/catalog/catalog-data.ts';
import { filterIsEditorialEntry } from '#lib/catalog/catalog-utils.ts';
import { getPostsCollection } from '#lib/collections/posts/posts-data.ts';
import { getContentPath } from '#lib/utils/routing.ts';

export const getStaticPaths = (async () => {
	const { entries } = await getPostsCollection();
	const catalog = await getCatalog();

	return entries.map((entry, index) => {
		const newer = entries[index - 1];
		const older = entries[index + 1];

		return {
			params: { post: entry.id },
			props: {
				backlinks: catalog.backlinksOf(entry.id).filter(filterIsEditorialEntry),
				entry,
				newerEntry: newer
					? { title: newer.data.title, url: getContentPath('posts', newer.id) }
					: undefined,
				olderEntry: older
					? { title: older.data.title, url: getContentPath('posts', older.id) }
					: undefined,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<PostDetail {...Astro.props} />
