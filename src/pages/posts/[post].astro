---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import PostDetail from '#layouts/post-detail.astro';
import { queryPostEntries } from '#lib/collections/posts/posts-utils.ts';
import { getAdjacentPaginationEntries } from '#lib/utils/pagination.ts';

export const getStaticPaths = (async () => {
	const entries = await queryPostEntries();

	return entries.map((entry, index) => ({
		params: { post: entry.id },
		props: { entry, ...getAdjacentPaginationEntries(entries, index) },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<PostDetail {...Astro.props} />
