---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import * as R from 'remeda';

import ProjectIndex from '#layouts/project-index.astro';
import { getProjectsCollection } from '#lib/collections/projects/projects-data.js';
import { sortByDateReverseChronological } from '#lib/utils/date.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries } = await getProjectsCollection();

	return paginate(R.sort(entries, sortByDateReverseChronological), { pageSize: 20 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ProjectIndex {...Astro.props} />
