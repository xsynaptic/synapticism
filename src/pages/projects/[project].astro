---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ProjectDetail from '#layouts/project-detail.astro';
import { getProjectsCollection } from '#lib/collections/projects/projects-data.ts';
import { queryProjectEntryContent } from '#lib/collections/projects/projects-utils.ts';

export const getStaticPaths = (async () => {
	const { entries } = await getProjectsCollection();

	return Promise.all(
		entries.map(async (entry) => ({
			params: { project: entry.id },
			props: {
				entry,
				relatedContent: await queryProjectEntryContent(entry),
			},
		})),
	);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ProjectDetail {...Astro.props} />
