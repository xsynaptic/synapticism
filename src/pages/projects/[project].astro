---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ProjectDetail from '#layouts/project-detail.astro';
import { getCatalog } from '#lib/catalog/catalog-data.js';
import { getProjectsCollection } from '#lib/collections/projects/projects-data.js';

export const getStaticPaths = (async () => {
	const { entries } = await getProjectsCollection();
	const catalog = await getCatalog();

	return entries.map((entry) => ({
		params: { project: entry.id },
		props: { entry, backlinks: catalog.backlinksOf(entry.id) },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ProjectDetail {...Astro.props} />
