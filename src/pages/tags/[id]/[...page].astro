---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import TagDetailLayout from '#layouts/tag-detail.astro';
import { getTagsCollection } from '#lib/collections/tags/tags-data.ts';
import { queryTagsEntryContent } from '#lib/collections/tags/tags-utils.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries } = await getTagsCollection();

	const paths = await Promise.all(
		entries.map(async (entry) => {
			const content = await queryTagsEntryContent(entry);

			return paginate(content, {
				pageSize: 20,
				params: { id: entry.id },
				props: { entry },
			});
		}),
	);

	return paths.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TagDetailLayout {...Astro.props} />
