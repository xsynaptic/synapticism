---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import { postListPageSize } from '#constants.ts';
import TagDetailLayout from '#layouts/tag-detail.astro';
import { getTagsCollection } from '#lib/collections/tags/tags-data.ts';
import { queryTagsEntryContent } from '#lib/collections/tags/tags-utils.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries } = await getTagsCollection();

	const paths = await Promise.all(
		entries.map(async (entry) => {
			return paginate(await queryTagsEntryContent(entry), {
				pageSize: postListPageSize,
				params: { id: entry.id },
				props: { entry },
			});
		}),
	);

	return paths.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TagDetailLayout {...Astro.props} />
