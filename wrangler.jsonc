{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "synapticism",
	"compatibility_date": "2026-08-04",
	"routes": [{ "pattern": "synapticism.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist/",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
	},
}
